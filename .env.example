# Local database
DATABASE_URL="postgresql://belief@127.0.0.1:5432/review_router_dev?schema=public"
TEST_DATABASE_URL="postgresql://belief@127.0.0.1:5432/review_router_test?schema=public"

# Local web/API URLs
REVIEW_ROUTER_WEB_URL="http://localhost:3000"
REVIEW_ROUTER_API_URL="http://localhost:4000"
# Public URL embedded into generated GitHub Actions workflows. Localhost is
# allowed only outside NODE_ENV=production.
REVIEW_ROUTER_PUBLIC_API_URL="http://localhost:4000"

# Auth/session placeholders for local development
AUTH_SECRET="replace-with-local-random-secret"
AUTH_TRUST_HOST="true"

# GitHub OAuth/App placeholders. Fill after creating the local GitHub App.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
# Encrypts GitHub App user access tokens for maintainer repository discovery.
REVIEW_ROUTER_TOKEN_ENCRYPTION_KEY=""
# Hosted deploys can set GITHUB_APP_PRIVATE_KEY directly as a secret env var.
# Local development should usually keep the PEM in .local-secrets and point to it.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_FILE=""
GITHUB_WEBHOOK_SECRET=""

# ReviewRouter runtime defaults
# Live ReviewRouter runtime used by generated setup PRs. Leave
# REVIEW_ROUTER_ACTION_REF unset unless you need a smoke branch or full
# repository/ref override.
REVIEW_ROUTER_ACTION_VERSION="v1"
# REVIEW_ROUTER_ACTION_REF="777genius/review-router@v1"
REVIEW_ROUTER_BLOCKED_ACTION_VERSIONS=""
REVIEW_ROUTER_DEFAULT_MODEL="gpt-5.5"
REVIEW_ROUTER_DEFAULT_EFFORT="medium"
REVIEW_ROUTER_ENABLE_CONFLICT_REVIEW_FALLBACK="1"
# Empty means all repositories. Set to comma-separated owner/repo values to
# restrict rollout during an incident or targeted smoke.
REVIEW_ROUTER_CONFLICT_REVIEW_FALLBACK_REPOSITORIES=""
REVIEW_ROUTER_ENABLE_CODEX_ROTATING_OAUTH="1"
# Empty means all repositories. Set to comma-separated owner/repo values to
# restrict rotating Codex rollout during an incident or targeted smoke.
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=""

# Worker runtime
REVIEW_ROUTER_OUTBOX_BATCH_SIZE="25"
REVIEW_ROUTER_OUTBOX_PROCESSING_STALE_MS="900000"
REVIEW_ROUTER_WORKER_IDLE_MS="5000"
REVIEW_ROUTER_WORKER_BUSY_MS="250"
REVIEW_ROUTER_WORKER_ERROR_MS="5000"
REVIEW_ROUTER_MAX_REPOSITORIES_PER_SYNC="250"

# Keep these disabled until the local GitHub App values above are filled.
# For local/private beta readiness, set both to 1 so setup PR provisioning is
# actually testable.
REVIEW_ROUTER_ENABLE_DASHBOARD_MUTATIONS="0"
REVIEW_ROUTER_ENABLE_WORKFLOW_PROVISIONING="0"
REVIEW_ROUTER_LOCAL_ADMIN_GITHUB_LOGINS=""
