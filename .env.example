# Local database
DATABASE_URL="postgresql://belief@127.0.0.1:5432/review_router_dev?schema=public"
TEST_DATABASE_URL="postgresql://belief@127.0.0.1:5432/review_router_test?schema=public"

# Local web/API URLs
REVIEW_ROUTER_WEB_URL="http://localhost:3000"
REVIEW_ROUTER_API_URL="http://localhost:4000"
# Public URL embedded into generated GitHub Actions workflows. Localhost is
# allowed only outside NODE_ENV=production.
REVIEW_ROUTER_PUBLIC_API_URL="http://localhost:4000"

# Auth/session placeholders for local development
AUTH_SECRET="replace-with-local-random-secret"
AUTH_TRUST_HOST="true"

# GitHub OAuth/App placeholders. Fill after creating the local GitHub App.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
# Encrypts GitHub App user access tokens for maintainer repository discovery.
REVIEW_ROUTER_TOKEN_ENCRYPTION_KEY=""
# Hosted deploys can set GITHUB_APP_PRIVATE_KEY directly as a secret env var.
# Local development should usually keep the PEM in .local-secrets and point to it.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_FILE=""
GITHUB_WEBHOOK_SECRET=""

# ReviewRouter runtime defaults
# Live ReviewRouter runtime used by generated setup PRs. Leave
# REVIEW_ROUTER_ACTION_REF unset unless you need a smoke branch or full
# repository/ref override.
REVIEW_ROUTER_ACTION_VERSION="main"
# REVIEW_ROUTER_ACTION_REF="777genius/review-router@main"
REVIEW_ROUTER_BLOCKED_ACTION_VERSIONS=""
# Authoritative hosted safety ceiling. Repository settings may lower this value
# but cannot raise or disable it.
REVIEW_ROUTER_HOSTED_MAX_CHANGED_LINES="250000"
REVIEW_ROUTER_DEFAULT_MODEL="gpt-5.5"
REVIEW_ROUTER_DEFAULT_EFFORT="xhigh"
# SHA-256 only. The plaintext review-config operator credential belongs in the
# local operator profile, never in this server env file.
REVIEW_ROUTER_REVIEW_CONFIG_OPERATOR_CREDENTIAL_SHA256=""
# Optional JSON key ring for signed external investigation evaluations.
# Each entry: {"keyId","publicKeySpkiBase64","notBefore","verifyUntil"}.
REVIEW_ROUTER_INVESTIGATION_EVALUATION_PUBLIC_KEYS_JSON=""
# Dedicated operation credentials must be different from each other.
REVIEW_ROUTER_INVESTIGATION_PROMOTION_CREDENTIAL_SHA256=""
REVIEW_ROUTER_INVESTIGATION_EVALUATION_IMPORT_CREDENTIAL_SHA256=""
# JSON array of authoritative {identity,trustProfile,thresholds} profiles.
REVIEW_ROUTER_INVESTIGATION_PROMOTION_POLICY_PROFILES_JSON=""
# Review Investigation rollout is dormant by default. Enable capabilities in
# dependency order and configure explicit selectors before production effects.
REVIEW_ROUTER_REVIEW_INVESTIGATION_RECORDING_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_SHADOW_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_CONTEXT_CRITIC_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_VERIFIED_CLEAN_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_CROSS_REVISION_REPLAY_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRODUCTION_EFFECTS_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_EMERGENCY_DISABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_SELECTORS_JSON=""
REVIEW_ROUTER_ENABLE_CONFLICT_REVIEW_FALLBACK="1"
# Empty means all repositories. Set to comma-separated owner/repo values to
# restrict rollout during an incident or targeted smoke.
REVIEW_ROUTER_CONFLICT_REVIEW_FALLBACK_REPOSITORIES=""
# Hosted release convergence is dormant. Canary/widening changes are explicit,
# observed operations and require a nonempty repository cohort.
REVIEW_ROUTER_ENABLE_CODEX_ROTATING_OAUTH="0"
REVIEW_ROUTER_CODEX_ROTATING_NEW_WORK_ADMISSION_ENABLED="0"
REVIEW_ROUTER_CODEX_ROTATING_SETUP_ISSUANCE_ENABLED="0"
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=""
REVIEW_ROUTER_REVIEW_V2_RUN_CONTROL_ENABLED="0"
REVIEW_ROUTER_REVIEW_V2_WORKER_ENABLED="0"
# Required only when REVIEW_ROUTER_REVIEW_V2_WORKER_ENABLED=1. This is a key ID,
# not key material; it must match the active v2 capability verifier key.
REVIEW_ROUTER_REVIEW_V2_CAPABILITY_ACTIVE_KEY_ID=""
# JSON array of {keyId,secretBase64,verifyUntil}; shared with the API key ring.
REVIEW_ROUTER_REVIEW_V2_CAPABILITY_KEYS_JSON=""
REVIEW_ROUTER_REVIEW_V2_DUE_LIMIT="25"
REVIEW_ROUTER_REVIEW_V2_RECOVERY_PAGE_SIZE="100"
REVIEW_ROUTER_REVIEW_V2_PUBLICATION_BATCH_SIZE="10"
REVIEW_ROUTER_REVIEW_V2_PUBLICATION_RETRY_MS="5000"
REVIEW_ROUTER_REVIEW_V2_MIN_MUTATION_LEASE_MS="30000"
# Required before investigation recording can accept private search queries.
# KEYS_JSON is an object of key ID -> unpadded base64url-encoded 32-byte key.
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_ACTIVE_KEY_ID=""
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_KEYS_JSON=""
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_TTL_MS="86400000"
# Required when investigation recording is enabled. Each run removes at most
# one bounded batch; all batch sizes have a hard maximum of 1000.
REVIEW_ROUTER_REVIEW_INVESTIGATION_MAINTENANCE_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_PRUNE_BATCH_SIZE="100"
REVIEW_ROUTER_REVIEW_INVESTIGATION_DOSSIER_PRUNE_BATCH_SIZE="100"
REVIEW_ROUTER_REVIEW_INVESTIGATION_SHADOW_EVIDENCE_PRUNE_BATCH_SIZE="100"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRUNE_INTERVAL_MS="3600000"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRUNE_LOCK_TTL_MS="300000"
# Empty means all repositories. Set to comma-separated owner/repo values to
# restrict rotating Codex rollout during an incident or targeted smoke.
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=""

# GitLab MVP integration. Runtime write tokens stay in GitLab CI/CD variables.
# Static repositories are an MVP registry until provider-neutral persistence is
# introduced. Example:
# REVIEW_ROUTER_GITLAB_STATIC_REPOSITORIES_JSON='[{"workspaceId":"workspace_1","repositoryId":"gitlab_123","gitlabProjectId":"123","fullName":"group/project","owner":"group","selected":true,"installationStatus":"active"}]'
REVIEW_ROUTER_GITLAB_STATIC_REPOSITORIES_JSON=""
REVIEW_ROUTER_GITLAB_API_BASE_URL="https://gitlab.com/api/v4"
REVIEW_ROUTER_GITLAB_API_TOKEN=""
REVIEW_ROUTER_GITLAB_OIDC_AUDIENCE="reviewrouter"
REVIEW_ROUTER_GITLAB_OIDC_ISSUER="https://gitlab.com"
REVIEW_ROUTER_GITLAB_OIDC_JWKS_URL=""
# Optional GitLab install endpoint. Requires both values; the admin token is a
# ReviewRouter bearer token for the install endpoint, not a GitLab token.
REVIEW_ROUTER_GITLAB_INSTALLER_TOKEN=""
REVIEW_ROUTER_GITLAB_INSTALLER_ADMIN_TOKEN=""
# Default image referenced by generated GitLab control-project CI config.
REVIEW_ROUTER_GITLAB_RUNTIME_IMAGE="ghcr.io/777genius/review-router-gitlab-runtime:v1"
# CI-local publishing CLI reads reviewrouter-findings.json and posts through
# provider adapters. GitLab review token should live in GitLab CI/CD variables.
REVIEWROUTER_GITLAB_TOKEN=""
REVIEWROUTER_GITLAB_API_BASE_URL="https://gitlab.com/api/v4"
REVIEWROUTER_FINDINGS_ARTIFACT_PATH="reviewrouter-findings.json"
REVIEWROUTER_REVIEW_MARKER="reviewrouter:gitlab:review"
REVIEWROUTER_MAX_INLINE_COMMENTS="20"

# Worker runtime
REVIEW_ROUTER_OUTBOX_BATCH_SIZE="25"
REVIEW_ROUTER_OUTBOX_PROCESSING_STALE_MS="900000"
REVIEW_ROUTER_WORKER_IDLE_MS="5000"
REVIEW_ROUTER_WORKER_BUSY_MS="250"
REVIEW_ROUTER_WORKER_ERROR_MS="5000"
REVIEW_ROUTER_MAX_REPOSITORIES_PER_SYNC="250"

# Keep these disabled until the local GitHub App values above are filled.
# For local/private beta readiness, set both to 1 so setup PR provisioning is
# actually testable.
REVIEW_ROUTER_ENABLE_DASHBOARD_MUTATIONS="0"
REVIEW_ROUTER_ENABLE_WORKFLOW_PROVISIONING="0"
REVIEW_ROUTER_LOCAL_ADMIN_GITHUB_LOGINS=""
