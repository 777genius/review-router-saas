# Local database
DATABASE_URL="postgresql://belief@127.0.0.1:5432/review_router_dev?schema=public"
TEST_DATABASE_URL="postgresql://belief@127.0.0.1:5432/review_router_test?schema=public"

# Local web/API URLs
REVIEW_ROUTER_WEB_URL="http://localhost:3000"
REVIEW_ROUTER_API_URL="http://localhost:4000"

# Auth/session placeholders for local development
AUTH_SECRET="replace-with-local-random-secret"
AUTH_TRUST_HOST="true"

# GitHub OAuth/App placeholders. Fill after creating the local GitHub App.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY_FILE=""
GITHUB_WEBHOOK_SECRET=""

# ReviewRouter runtime defaults
# Local beta default is intentionally live main so smoke installs pick up the
# current runtime fixes. Leave REVIEW_ROUTER_ACTION_REF unset unless you need a
# smoke branch or a pinned release override.
REVIEW_ROUTER_ACTION_VERSION="main"
# REVIEW_ROUTER_ACTION_REF="777genius/review-router@main"
REVIEW_ROUTER_BLOCKED_ACTION_VERSIONS=""
REVIEW_ROUTER_DEFAULT_MODEL="gpt-5.5"
REVIEW_ROUTER_DEFAULT_EFFORT="medium"

# Worker runtime
REVIEW_ROUTER_OUTBOX_BATCH_SIZE="25"
REVIEW_ROUTER_OUTBOX_PROCESSING_STALE_MS="900000"
REVIEW_ROUTER_WORKER_IDLE_MS="5000"
REVIEW_ROUTER_WORKER_BUSY_MS="250"
REVIEW_ROUTER_WORKER_ERROR_MS="5000"
REVIEW_ROUTER_MAX_REPOSITORIES_PER_SYNC="250"

# Keep these disabled until the local GitHub App values above are filled.
# For local/private beta readiness, set both to 1 so setup PR provisioning is
# actually testable.
REVIEW_ROUTER_ENABLE_DASHBOARD_MUTATIONS="0"
REVIEW_ROUTER_ENABLE_WORKFLOW_PROVISIONING="0"
REVIEW_ROUTER_LOCAL_ADMIN_GITHUB_LOGINS=""
