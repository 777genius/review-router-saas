{
  "name": "review-router",
  "private": true,
  "bin": {
    "reviewrouter": "./apps/api/dist/reviewrouter-operator-cli.js"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/run-with-env.mjs turbo run dev --parallel",
    "web:dev": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/web dev",
    "api:dev": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/api dev",
    "worker:dev": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/worker dev",
    "web:start": "pnpm --filter @reviewrouter/web exec next start",
    "build": "turbo run build && node scripts/rewrite-dist-esm-imports.mjs",
    "protocol:bootstrap": "node scripts/check-review-action-v2-protocol.mjs --bootstrap-only",
    "protocol:generate": "node --conditions=production scripts/generate-review-action-v2-protocol.mjs",
    "protocol:check": "node scripts/check-review-action-v2-protocol.mjs",
    "protocol:export-public": "node scripts/export-public-review-action-v2-contract.mjs",
    "protocol:release-manifest": "node scripts/generate-public-review-action-v2-release-manifest.mjs",
    "protocol:release-manifest:check": "node scripts/check-public-review-action-v2-release-manifest.mjs",
    "protocol:handoff:test": "vitest run scripts/review-action-v2-release-manifests.test.ts scripts/export-public-review-action-v2-contract.test.ts",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.spikes.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "local:bootstrap": "bash scripts/bootstrap-local.sh",
    "local:check": "bash scripts/check-local-readiness.sh",
    "hosted:check": "node scripts/check-hosted-readiness.mjs",
    "hosted:check:smoke": "node scripts/check-hosted-readiness-smoke.mjs",
    "hosted:web:check": "node scripts/check-hosted-web.mjs",
    "self-hosted:check": "node scripts/check-self-hosted-readiness.mjs && node scripts/check-self-hosted-compose-contract.mjs",
    "self-hosted:check:smoke": "node scripts/check-self-hosted-readiness-smoke.mjs && node scripts/check-self-hosted-compose-contract.mjs",
    "self-hosted:compose:check": "node scripts/check-self-hosted-compose-contract.mjs",
    "self-hosted:e2e": "node scripts/run-self-hosted-e2e.mjs",
    "public-beta:check:smoke": "node scripts/check-public-beta-readiness-smoke.mjs",
    "beta:check": "bash scripts/check-beta-readiness.sh",
    "web:smoke": "node scripts/run-with-env.mjs node scripts/check-web-pages.mjs",
    "db:generate": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:generate",
    "db:push": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:push",
    "db:migrate": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:migrate",
    "spike:github:list-installations": "tsx spikes/github-oidc/src/list-installations.ts",
    "spike:github:sync-repositories": "tsx spikes/github-oidc/src/sync-installation-repositories.ts",
    "spike:github:provision-workflow": "tsx spikes/github-oidc/src/provision-workflow.ts",
    "spike:github:fresh-repo:e2e": "tsx spikes/github-oidc/src/fresh-repository-e2e.ts",
    "spike:github:codex-rotating:e2e": "tsx spikes/github-oidc/src/codex-rotating-live-e2e.ts",
    "spike:github:create-setup-pr": "tsx spikes/github-oidc/src/create-setup-pr.ts",
    "spike:action:e2e": "tsx spikes/github-oidc/src/action-control-plane-e2e.ts",
    "spike:review-config:e2e": "tsx spikes/github-oidc/src/review-config-override-e2e.ts",
    "spike:support-diagnostics:e2e": "tsx spikes/github-oidc/src/support-diagnostics-e2e.ts",
    "spike:memory:e2e": "node scripts/run-memory-e2e.mjs",
    "spike:auth-workspace:e2e": "tsx spikes/github-oidc/src/auth-workspace-access-e2e.ts",
    "spike:webhook-lifecycle:e2e": "tsx spikes/github-oidc/src/webhook-lifecycle-e2e.ts",
    "spike:server": "tsx spikes/github-oidc/src/server.ts",
    "spike:test": "vitest run spikes/github-oidc/tests",
    "db:migrate:deploy": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:migrate:deploy",
    "db:migrate:status": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:migrate:status",
    "db:migrate:smoke": "node scripts/run-with-env.mjs node scripts/check-migration-smoke.mjs",
    "outbox:fencing:cutover": "node scripts/run-with-env.mjs node scripts/activate-outbox-fencing.mjs",
    "review-v2:migrate": "node scripts/run-with-env.mjs node scripts/review-v2-migrate.mjs",
    "review-v2:migration-rehearsal": "node scripts/run-with-env.mjs node scripts/check-review-v2-migration-rehearsal.mjs",
    "review-v2:e2e": "REVIEW_ROUTER_REVIEW_V2_E2E=1 vitest run scripts/review-action-v2-production-e2e/review-action-v2-production.e2e.test.ts",
    "review-v2:admin": "node scripts/run-with-env.mjs node --conditions=production apps/api/dist/review-action-v2-operator-cli.js",
    "reviewrouter": "node scripts/run-with-env.mjs node --conditions=production apps/api/dist/reviewrouter-operator-cli.js",
    "db:restore:smoke": "node scripts/run-with-env.mjs node scripts/check-backup-restore-smoke.mjs",
    "spike:outbox-maintenance:e2e": "tsx spikes/github-oidc/src/outbox-maintenance-e2e.ts",
    "spike:repo-health:e2e": "tsx spikes/github-oidc/src/repo-health-workflow-e2e.ts",
    "spike:rate-limit:e2e": "tsx spikes/github-oidc/src/rate-limit-e2e.ts",
    "spike:distributed-lock:e2e": "tsx spikes/github-oidc/src/distributed-lock-e2e.ts",
    "spike:github-memory:e2e": "node scripts/run-github-memory-smoke.mjs",
    "api:start": "node --conditions=production apps/api/dist/server.js",
    "worker:start": "node --conditions=production apps/worker/dist/worker.js",
    "runtime:smoke": "node scripts/run-with-env.mjs node scripts/check-production-runtime.mjs",
    "action:build": "node scripts/build-codex-rotating-action.mjs",
    "action:artifact:check": "node scripts/check-codex-rotating-action-artifact.mjs",
    "action:artifact:check:smoke": "REVIEWROUTER_CODEX_ROTATING_ACTION_REQUIRE_BINARY=0 node scripts/check-codex-rotating-action-artifact.mjs",
    "action:sync-public-runtime": "node scripts/sync-public-action-runtime.mjs",
    "subscription-runtime:contract": "node scripts/check-external-subscription-runtime.mjs",
    "subscription-runtime:redaction-canary": "node scripts/check-external-subscription-runtime.mjs",
    "subscription-runtime:e2e:local": "node scripts/check-external-subscription-runtime.mjs",
    "subscription-runtime:live-e2e:prereq": "node scripts/run-subscription-runtime-live-e2e.mjs --check-only",
    "subscription-runtime:live-e2e:smoke": "node scripts/check-subscription-runtime-live-e2e-smoke.mjs",
    "subscription-runtime:live-e2e": "node scripts/run-subscription-runtime-live-e2e.mjs",
    "subscription-runtime:worker-benchmark": "tsx spikes/subscription-runtime-worker-benchmark/benchmark-codex-worker.ts",
    "subscription-runtime:sync-public-mirrors": "node -e \"console.log('subscription-runtime mirrors are deprecated; use 777genius/ar')\"",
    "subscription-runtime:check": "node scripts/check-external-subscription-runtime.mjs && pnpm action:build && pnpm action:artifact:check:smoke && pnpm subscription-runtime:live-e2e:smoke",
    "subscription-runtime:release-gate": "pnpm subscription-runtime:check && pnpm action:artifact:check && pnpm exec vitest run packages/features/codex-oauth-rotating/src/tests/codex-oauth-rotating.test.ts packages/features/codex-oauth-rotating/src/tests/github-action.test.ts && pnpm architecture:check && pnpm typecheck && git diff --check",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs",
    "github-app:check": "node scripts/run-with-env.mjs node scripts/check-github-app-readiness.mjs",
    "github-app:create": "node scripts/create-github-app-manifest.mjs",
    "github-app:manifest:smoke": "node scripts/check-github-app-manifest-smoke.mjs",
    "github-app:use-profile": "node scripts/use-github-app-profile.mjs",
    "public-beta:check": "bash scripts/check-public-beta-readiness.sh",
    "deploy:render:hosted-beta": "node scripts/deploy-render-hosted-beta.mjs",
    "ops:sync-action-ref": "node scripts/sync-render-action-ref.mjs",
    "hosted:api-demo:check": "node scripts/check-hosted-api-demo.mjs",
    "web:ui-audit": "node scripts/check-ui-layout.mjs",
    "hosted:ui-audit": "node scripts/check-ui-layout.mjs --base-url https://reviewrouter.site",
    "release:sync-major": "node scripts/sync-major-release-tag.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.8",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.11",
    "nuqs": "^2.8.9",
    "pg-boss": "^12.18.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "optionalDependencies": {
    "@777genius/subscription-runtime": "git+ssh://git@github.com/777genius/ar.git#v0.1.0-main.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.11",
      "brace-expansion@>=3.0.0 <5.0.7": "5.0.8",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <4.0.0": "3.1.4",
      "hono": "4.12.32",
      "postcss": "8.5.14",
      "sharp": "0.35.3",
      "undici@>=7.0.0 <8.0.0": "7.29.0",
      "vite@>=8.0.0 <9.0.0": "8.1.5"
    }
  }
}
