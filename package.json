{
  "name": "review-router",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/run-with-env.mjs turbo run dev --parallel",
    "web:dev": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/web dev",
    "api:dev": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/api dev",
    "worker:dev": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/worker dev",
    "web:start": "pnpm --filter @reviewrouter/web exec next start",
    "build": "turbo run build && node scripts/rewrite-dist-esm-imports.mjs",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.spikes.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "local:bootstrap": "bash scripts/bootstrap-local.sh",
    "local:check": "bash scripts/check-local-readiness.sh",
    "hosted:check": "node scripts/check-hosted-readiness.mjs",
    "hosted:check:smoke": "node scripts/check-hosted-readiness-smoke.mjs",
    "hosted:web:check": "node scripts/check-hosted-web.mjs",
    "public-beta:check:smoke": "node scripts/check-public-beta-readiness-smoke.mjs",
    "beta:check": "bash scripts/check-beta-readiness.sh",
    "web:smoke": "node scripts/run-with-env.mjs node scripts/check-web-pages.mjs",
    "db:generate": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:generate",
    "db:push": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:push",
    "db:migrate": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:migrate",
    "spike:github:list-installations": "tsx spikes/github-oidc/src/list-installations.ts",
    "spike:github:sync-repositories": "tsx spikes/github-oidc/src/sync-installation-repositories.ts",
    "spike:github:provision-workflow": "tsx spikes/github-oidc/src/provision-workflow.ts",
    "spike:github:fresh-repo:e2e": "tsx spikes/github-oidc/src/fresh-repository-e2e.ts",
    "spike:github:create-setup-pr": "tsx spikes/github-oidc/src/create-setup-pr.ts",
    "spike:action:e2e": "tsx spikes/github-oidc/src/action-control-plane-e2e.ts",
    "spike:review-config:e2e": "tsx spikes/github-oidc/src/review-config-override-e2e.ts",
    "spike:support-diagnostics:e2e": "tsx spikes/github-oidc/src/support-diagnostics-e2e.ts",
    "spike:auth-workspace:e2e": "tsx spikes/github-oidc/src/auth-workspace-access-e2e.ts",
    "spike:webhook-lifecycle:e2e": "tsx spikes/github-oidc/src/webhook-lifecycle-e2e.ts",
    "spike:server": "tsx spikes/github-oidc/src/server.ts",
    "spike:test": "vitest run spikes/github-oidc/tests",
    "db:migrate:deploy": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:migrate:deploy",
    "db:migrate:status": "node scripts/run-with-env.mjs pnpm --filter @reviewrouter/platform-db db:migrate:status",
    "db:migrate:smoke": "node scripts/run-with-env.mjs node scripts/check-migration-smoke.mjs",
    "db:restore:smoke": "node scripts/run-with-env.mjs node scripts/check-backup-restore-smoke.mjs",
    "spike:outbox-maintenance:e2e": "tsx spikes/github-oidc/src/outbox-maintenance-e2e.ts",
    "spike:repo-health:e2e": "tsx spikes/github-oidc/src/repo-health-workflow-e2e.ts",
    "spike:rate-limit:e2e": "tsx spikes/github-oidc/src/rate-limit-e2e.ts",
    "spike:distributed-lock:e2e": "tsx spikes/github-oidc/src/distributed-lock-e2e.ts",
    "api:start": "node --conditions=production apps/api/dist/server.js",
    "worker:start": "node --conditions=production apps/worker/dist/worker.js",
    "runtime:smoke": "node scripts/run-with-env.mjs node scripts/check-production-runtime.mjs",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs",
    "github-app:check": "node scripts/run-with-env.mjs node scripts/check-github-app-readiness.mjs",
    "github-app:create": "node scripts/create-github-app-manifest.mjs",
    "github-app:use-profile": "node scripts/use-github-app-profile.mjs",
    "public-beta:check": "bash scripts/check-public-beta-readiness.sh",
    "deploy:render:hosted-beta": "node scripts/deploy-render-hosted-beta.mjs",
    "hosted:api-demo:check": "node scripts/check-hosted-api-demo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.8",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "nuqs": "^2.8.9",
    "pg-boss": "^12.18.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
