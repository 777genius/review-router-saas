  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.0"
