{
  "name": "@reviewrouter/features-action-control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./v2": {
      "types": "./src/v2/interface/index.ts",
      "production": "./dist/v2/interface/index.js",
      "default": "./src/v2/interface/index.ts"
    },
    "./v2/contract-source": {
      "types": "./src/v2/contract-source/index.ts",
      "production": "./dist/v2/contract-source/index.js",
      "default": "./src/v2/contract-source/index.ts"
    }
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@reviewrouter/features-codex-oauth-rotating": "workspace:*",
    "@reviewrouter/features-review-config": "workspace:*",
    "@reviewrouter/features-review-execution-checkpoints": "workspace:*",
    "@reviewrouter/features-review-providers": "workspace:*",
    "@reviewrouter/features-review-snapshots": "workspace:*",
    "@reviewrouter/protocol-review-action-v2": "workspace:*",
    "@reviewrouter/protocol-review-workflow": "workspace:*",
    "@reviewrouter/platform-db": "workspace:*",
    "@reviewrouter/shared": "workspace:*",
    "jose": "^6.2.3",
    "zod": "^4.4.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:contract-source": "tsc -p tsconfig.contract-source.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
