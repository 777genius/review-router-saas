generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       WorkspaceMember[]
  installations GitHubInstallation[]
  repositories  RepositoryConnection[]
  provisioning  WorkflowProvisioning[]
  reviewConfigs ReviewConfiguration[]
  providerSetup ProviderSetupState[]
  actionHealth  ActionRunHealthReport[]
  auditEvents   AuditEvent[]
}

model User {
  id           String   @id @default(cuid())
  githubUserId BigInt   @unique
  githubLogin  String
  primaryEmail String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMember[]

  @@index([githubLogin])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String?
  githubLogin String?
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, githubLogin])
  @@index([workspaceId, role])
}

model GitHubInstallation {
  id                   String                    @id @default(cuid())
  workspaceId          String
  githubInstallationId BigInt                    @unique
  accountLogin         String
  accountType          String
  repositorySelection  String
  status               GitHubInstallationStatus  @default(active)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories RepositoryConnection[]

  @@index([workspaceId, status])
}

model RepositoryConnection {
  id                   String                 @id @default(cuid())
  workspaceId          String
  installationId       String
  githubRepositoryId   BigInt                 @unique
  owner                String
  name                 String
  fullName             String
  defaultBranch        String
  visibility           RepositoryVisibility
  selected             Boolean                @default(true)
  archived             Boolean                @default(false)
  setupStatus          RepositorySetupStatus  @default(not_configured)
  lastSyncedAt         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  provisioning WorkflowProvisioning[]
  reviewConfigs ReviewConfiguration[]
  providerSetup ProviderSetupState[]
  actionHealth ActionRunHealthReport[]

  @@unique([workspaceId, fullName])
  @@index([installationId])
  @@index([workspaceId, setupStatus])
  @@index([workspaceId, selected, fullName])
}

model ReviewConfiguration {
  id          String              @id @default(cuid())
  workspaceId String
  repositoryId String?
  targetKey   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  versions   ReviewConfigurationVersion[]

  @@unique([workspaceId, targetKey])
  @@index([workspaceId, repositoryId])
}

model ReviewConfigurationVersion {
  id                String   @id @default(cuid())
  configurationId   String
  version           Int
  schemaVersion     Int      @default(1)
  providerKind      String
  providerAuthMode  String
  model             String
  reasoningEffort   String
  agenticContext    Boolean  @default(true)
  failOnSeverity    String
  inlineMaxComments Int
  targetTokensPerBatch Int
  createdAt         DateTime @default(now())

  configuration ReviewConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, version])
  @@index([configurationId, createdAt])
}

model ProviderSetupState {
  id           String   @id @default(cuid())
  workspaceId  String
  repositoryId String?
  targetKey    String
  providerKind String
  authMode     String
  state        ProviderSecretState @default(unknown)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, targetKey, providerKind, authMode])
  @@index([workspaceId, state])
}

model ActionRunHealthReport {
  id                 String   @id @default(cuid())
  workspaceId        String
  repositoryId       String
  githubRunId        String
  githubRunAttempt   String
  eventName          String
  actionVersion      String
  configVersion      Int
  providerSetupState ProviderSecretState
  providerHealth     ActionProviderHealth
  safeErrorCategory  String
  safeErrorSummary   String?
  startedAt          DateTime?
  finishedAt         DateTime?
  receivedAt         DateTime
  createdAt          DateTime @default(now())

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, receivedAt])
  @@index([repositoryId, githubRunId, githubRunAttempt])
}

model WorkflowProvisioning {
  id              String                     @id @default(cuid())
  workspaceId     String
  repositoryId    String
  status          WorkflowProvisioningStatus @default(not_started)
  branch          String
  workflowPath    String
  actionVersion   String
  pullRequestUrl  String?
  errorMessage    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, branch])
  @@index([workspaceId, status])
  @@index([repositoryId, status])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actor       String
  action      String
  targetType  String
  targetId    String
  metadata    Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
}

model GitHubWebhookDelivery {
  id             String    @id @default(cuid())
  deliveryId     String    @unique
  eventName      String
  action         String?
  installationId BigInt?
  payloadHash    String?
  normalizedEvent Json?
  status         WebhookDeliveryStatus @default(received)
  errorSummary   String?
  processedAt    DateTime?
  receivedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([eventName, createdAt])
  @@index([installationId])
  @@index([status, receivedAt])
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum GitHubInstallationStatus {
  pending
  active
  suspended
  removed
  permission_error
  sync_error
}

enum RepositoryVisibility {
  public
  private
  internal
}

enum RepositorySetupStatus {
  not_configured
  setup_pr_open
  configured
  needs_attention
}

enum WorkflowProvisioningStatus {
  not_started
  setup_pr_open
  configured
  failed
}

enum ProviderSecretState {
  unknown
  missing
  configured
  stale_or_invalid
  unavailable_in_fork_pr
}

enum ActionProviderHealth {
  ok
  skipped
  failed
  degraded
}

enum WebhookDeliveryStatus {
  received
  processing
  processed
  failed
}
