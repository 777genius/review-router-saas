generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                WorkspaceMember[]
  installations          GitHubInstallation[]
  repositories           RepositoryConnection[]
  provisioning           WorkflowProvisioning[]
  orgRulesets            OrgRulesetProvisioning[]
  reviewConfigs          ReviewConfiguration[]
  providerSetup          ProviderSetupState[]
  actionHealth           ActionRunHealthReport[]
  conflictReviewAttempts ConflictReviewAttempt[]
  auditEvents            AuditEvent[]
  entitlement            WorkspaceEntitlement?
  memoryItems            MemoryItem[]
  memorySuggestions      MemorySuggestion[]
  memoryUsageEvents      MemoryUsageEvent[]
}

model User {
  id           String   @id @default(cuid())
  githubUserId BigInt   @unique
  githubLogin  String
  primaryEmail String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                WorkspaceMember[]
  githubAuthorizations       GitHubUserAuthorization[]
  repositoryPermissionCaches RepositoryPermissionCache[]
  memoryItems                MemoryItem[]
  memorySuggestions          MemorySuggestion[]

  @@index([githubLogin])
}

model GitHubUserAuthorization {
  id                    String    @id @default(cuid())
  userId                String
  githubUserId          BigInt
  appSlug               String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  revokedAt             DateTime?
  lastErrorCode         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appSlug])
  @@index([githubUserId])
  @@index([revokedAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String?
  githubLogin String?
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, githubLogin])
  @@index([workspaceId, role])
}

model GitHubInstallation {
  id                   String                   @id @default(cuid())
  workspaceId          String
  githubInstallationId BigInt                   @unique
  accountLogin         String
  accountType          String
  accountAvatarUrl     String?
  repositorySelection  String
  status               GitHubInstallationStatus @default(active)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories RepositoryConnection[]
  orgRulesets  OrgRulesetProvisioning[]

  @@index([workspaceId, status])
}

model RepositoryConnection {
  id                 String                @id @default(cuid())
  workspaceId        String
  installationId     String
  githubRepositoryId BigInt                @unique
  owner              String
  name               String
  fullName           String
  defaultBranch      String
  visibility         RepositoryVisibility
  selected           Boolean               @default(true)
  archived           Boolean               @default(false)
  stargazersCount    Int                   @default(0)
  setupStatus        RepositorySetupStatus @default(not_configured)
  lastSyncedAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace              Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation           GitHubInstallation          @relation(fields: [installationId], references: [id], onDelete: Cascade)
  provisioning           WorkflowProvisioning[]
  reviewConfigs          ReviewConfiguration[]
  providerSetup          ProviderSetupState[]
  actionHealth           ActionRunHealthReport[]
  conflictReviewAttempts ConflictReviewAttempt[]
  rulesetSources         OrgRulesetProvisioning[]    @relation("OrgRulesetSourceRepository")
  permissionCache        RepositoryPermissionCache[]
  memoryItems            MemoryItem[]
  memorySuggestions      MemorySuggestion[]
  memoryUsageEvents      MemoryUsageEvent[]

  @@unique([workspaceId, fullName])
  @@index([installationId])
  @@index([workspaceId, setupStatus])
  @@index([workspaceId, selected, fullName])
}

model RepositoryPermissionCache {
  id                   String   @id @default(cuid())
  userId               String
  repositoryId         String
  githubInstallationId BigInt
  permission           String?
  roleName             String?
  canManage            Boolean
  checkedAt            DateTime
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId, canManage, expiresAt])
  @@index([repositoryId])
  @@index([githubInstallationId])
}

model ReviewConfiguration {
  id           String   @id @default(cuid())
  workspaceId  String
  repositoryId String?
  targetKey    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection?        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  versions   ReviewConfigurationVersion[]

  @@unique([workspaceId, targetKey])
  @@index([workspaceId, repositoryId])
}

model ReviewConfigurationVersion {
  id                   String   @id @default(cuid())
  configurationId      String
  version              Int
  schemaVersion        Int      @default(1)
  providerKind         String
  providerAuthMode     String
  model                String
  reasoningEffort      String
  agenticContext       Boolean  @default(true)
  fastMode             Boolean  @default(false)
  failOnSeverity       String
  inlineMaxComments    Int
  providerLimit        Int      @default(1)
  providerMaxParallel  Int      @default(1)
  inlineMinAgreement   Int      @default(1)
  targetTokensPerBatch Int
  createdAt            DateTime @default(now())

  configuration ReviewConfiguration                  @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  providers     ReviewConfigurationVersionProvider[]

  @@unique([configurationId, version])
  @@index([configurationId, createdAt])
}

model ReviewConfigurationVersionProvider {
  id                     String  @id @default(cuid())
  configurationVersionId String
  order                  Int
  providerKind           String
  providerAuthMode       String
  model                  String
  reasoningEffort        String
  agenticContext         Boolean @default(true)
  fastMode               Boolean @default(false)

  configurationVersion ReviewConfigurationVersion @relation(fields: [configurationVersionId], references: [id], onDelete: Cascade)

  @@unique([configurationVersionId, order])
  @@index([configurationVersionId])
}

model ProviderSetupState {
  id           String              @id @default(cuid())
  workspaceId  String
  repositoryId String?
  targetKey    String
  providerKind String
  authMode     String
  state        ProviderSecretState @default(unknown)
  updatedAt    DateTime            @updatedAt
  createdAt    DateTime            @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, targetKey, providerKind, authMode])
  @@index([workspaceId, state])
}

model ActionRunHealthReport {
  id                    String               @id @default(cuid())
  workspaceId           String
  repositoryId          String
  githubRunId           String
  githubRunAttempt      String
  eventName             String
  actionVersion         String
  configVersion         Int
  configSource          String?
  providerSetupState    ProviderSecretState
  providerHealth        ActionProviderHealth
  safeErrorCategory     String
  safeErrorSummary      String?
  findingCriticalCount  Int?
  findingMajorCount     Int?
  findingMinorCount     Int?
  findingInfoCount      Int?
  inlineCommentCount    Int?
  summaryCommentCount   Int?
  skippedReasonCategory String?
  startedAt             DateTime?
  finishedAt            DateTime?
  receivedAt            DateTime
  createdAt             DateTime             @default(now())

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, githubRunId, githubRunAttempt])
  @@index([workspaceId, receivedAt])
}

model ConflictReviewAttempt {
  id                        String                      @id @default(cuid())
  workspaceId               String
  repositoryId              String
  githubRepositoryId        BigInt
  githubInstallationId      BigInt
  pullRequestNumber         Int
  headSha                   String
  baseRef                   String
  baseSha                   String
  fallbackVersion           Int
  dispatchId                String                      @unique
  dispatchNonceHash         String
  dispatchEventType         String
  status                    ConflictReviewAttemptStatus @default(recorded)
  version                   Int                         @default(1)
  githubRunId               String?
  githubRunAttempt          String?
  configSnapshotId          String?
  postingManifestHash       String?
  safeErrorCode             String?
  safeErrorSummary          String?
  normalReviewRecheckNeeded Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  dispatchedAt              DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?

  workspace      Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository     RepositoryConnection          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  postingIntents ConflictReviewPostingIntent[]

  @@unique([repositoryId, pullRequestNumber, headSha, baseRef, baseSha, fallbackVersion])
  @@index([workspaceId, status])
  @@index([repositoryId, pullRequestNumber, status])
  @@index([githubRepositoryId, pullRequestNumber, headSha])
  @@index([dispatchId, status])
}

model ConflictReviewPostingIntent {
  id                   String                            @id @default(cuid())
  attemptId            String
  operationKind        String
  operationFingerprint String
  manifestHash         String
  status               ConflictReviewPostingIntentStatus @default(pending)
  githubExternalId     String?
  githubUrl            String?
  bodyHash             String?
  safeErrorCode        String?
  safeErrorSummary     String?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  completedAt          DateTime?

  attempt ConflictReviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, operationKind, operationFingerprint])
  @@index([attemptId, status])
}

model WorkflowProvisioning {
  id             String                     @id @default(cuid())
  workspaceId    String
  repositoryId   String
  status         WorkflowProvisioningStatus @default(not_started)
  branch         String
  workflowPath   String
  workflowStyle  String                     @default("explicit")
  actionVersion  String
  pullRequestUrl String?
  errorMessage   String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, branch])
  @@index([workspaceId, status])
  @@index([repositoryId, status])
}

model OrgRulesetProvisioning {
  id                       String                       @id @default(cuid())
  workspaceId              String
  installationId           String
  githubInstallationId     BigInt
  organizationLogin        String
  status                   OrgRulesetProvisioningStatus @default(requested)
  scope                    OrgRulesetScope
  enforcement              OrgRulesetEnforcement
  sourceRepositoryId       String?
  sourceGithubRepositoryId BigInt?
  sourceRepositoryFullName String?
  sourceWorkflowPath       String
  sourceWorkflowRef        String
  sourceWorkflowSha        String?
  rulesetId                BigInt?
  rulesetUrl               String?
  targetRepositoryIds      Json
  safeErrorCode            String?
  safeErrorSummary         String?
  requestedBy              String
  requestedAt              DateTime
  lastAttemptAt            DateTime?
  configuredAt             DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation     GitHubInstallation    @relation(fields: [installationId], references: [id], onDelete: Cascade)
  sourceRepository RepositoryConnection? @relation("OrgRulesetSourceRepository", fields: [sourceRepositoryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId])
  @@index([githubInstallationId, status])
  @@index([installationId, status])
  @@index([sourceRepositoryId])
  @@index([workspaceId, status])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actor       String
  action      String
  targetType  String
  targetId    String
  metadata    Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
}

model GitHubWebhookDelivery {
  id              String                @id @default(cuid())
  deliveryId      String                @unique
  eventName       String
  action          String?
  installationId  BigInt?
  payloadHash     String?
  normalizedEvent Json?
  status          WebhookDeliveryStatus @default(received)
  errorSummary    String?
  processedAt     DateTime?
  receivedAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt

  @@index([eventName, createdAt])
  @@index([installationId])
  @@index([status, receivedAt])
}

model OutboxEvent {
  id                   String            @id @default(cuid())
  type                 String
  version              Int
  idempotencyKey       String            @unique
  workspaceId          String?
  repositoryId         String?
  aggregateId          String?
  payload              Json
  status               OutboxEventStatus @default(pending)
  attempts             Int               @default(0)
  maxAttempts          Int               @default(5)
  nextAttemptAt        DateTime?
  processedAt          DateTime?
  deadLetteredAt       DateTime?
  lastErrorCode        String?
  safeLastErrorSummary String?
  occurredAt           DateTime
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt

  @@index([status, nextAttemptAt])
  @@index([workspaceId, status])
  @@index([repositoryId, status])
  @@index([type, version, status])
}

model WorkspaceEntitlement {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  plan        String   @default("free_beta")
  status      String   @default("active")
  limits      Json
  flags       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([plan, status])
}

model MemoryItem {
  id                  String               @id @default(cuid())
  schemaVersion       Int                  @default(1)
  workspaceId         String
  repositoryId        String?
  userId              String?
  scope               MemoryScope
  status              MemoryItemStatus     @default(active)
  body                String
  bodyVersion         Int                  @default(1)
  bodyHash            String
  tags                Json
  riskLevel           MemoryRiskLevel
  confidence          Float                @default(1)
  source              Json
  policyVersion       Int                  @default(1)
  safetyPolicyVersion Int                  @default(1)
  createdBy           String
  confirmedBy         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  lastUsedAt          DateTime?
  expiresAt           DateTime?
  version             Int                  @default(1)
  visibility          MemoryItemVisibility
  originSuggestionId  String?
  indexState          MemoryIndexState     @default(index_pending)
  indexVersion        Int?

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository  RepositoryConnection? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user        User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents MemoryUsageEvent[]

  @@index([workspaceId, scope, status, updatedAt])
  @@index([workspaceId, repositoryId, status, updatedAt])
  @@index([workspaceId, userId, status])
  @@index([status, expiresAt, workspaceId])
  @@index([status, updatedAt, workspaceId])
  @@index([workspaceId, bodyHash])
  @@index([originSuggestionId])
}

model MemorySuggestion {
  id                         String                 @id @default(cuid())
  schemaVersion              Int                    @default(1)
  workspaceId                String
  repositoryId               String?
  userId                     String?
  suggestedScope             MemoryScope
  suggestedBody              String
  suggestedBodyVersion       Int                    @default(1)
  suggestedBodyHash          String
  reason                     String
  source                     Json
  safetyReport               Json
  policyVersion              Int                    @default(1)
  safetyPolicyVersion        Int                    @default(1)
  status                     MemorySuggestionStatus @default(pending)
  createdByActor             String
  confirmationTokenHash      String?
  confirmationTokenExpiresAt DateTime?
  expiresAt                  DateTime
  dedupeKey                  String
  relatedMemoryItemId        String?
  relatedSuggestionId        String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @default(now()) @updatedAt
  resolvedAt                 DateTime?
  resolvedBy                 String?
  resolutionReason           String?
  version                    Int                    @default(1)

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, expiresAt])
  @@index([status, expiresAt, workspaceId])
  @@index([workspaceId, repositoryId, status, updatedAt])
  @@index([workspaceId, userId, status])
  @@index([workspaceId, dedupeKey])
  @@index([relatedMemoryItemId])
  @@index([relatedSuggestionId])
}

model MemoryUsageEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  repositoryId  String
  memoryItemId  String
  eventType     String
  bundleVersion Int?
  dedupeKey     String?
  metadata      Json
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  memoryItem MemoryItem           @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([workspaceId, occurredAt])
  @@index([repositoryId, occurredAt])
  @@index([memoryItemId, occurredAt])
}

model RateLimitBucket {
  key          String   @id
  count        Int
  limit        Int
  windowStart  DateTime
  windowEndsAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([windowEndsAt])
}

model DistributedLock {
  key       String   @id
  owner     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([expiresAt])
}

model ActionOidcReplayNonce {
  key       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum GitHubInstallationStatus {
  pending
  active
  suspended
  removed
  permission_error
  sync_error
}

enum RepositoryVisibility {
  public
  private
  internal
}

enum RepositorySetupStatus {
  not_configured
  setup_pr_open
  configured
  needs_attention
}

enum WorkflowProvisioningStatus {
  not_started
  setup_pr_open
  configured
  failed
}

enum OrgRulesetProvisioningStatus {
  requested
  processing
  configured
  failed
}

enum OrgRulesetScope {
  selected_repositories
  all_repositories
}

enum OrgRulesetEnforcement {
  evaluate
  active
}

enum ProviderSecretState {
  unknown
  missing
  configured
  stale_or_invalid
  unavailable_in_fork_pr
}

enum ActionProviderHealth {
  ok
  skipped
  failed
  degraded
}

enum WebhookDeliveryStatus {
  received
  processing
  processed
  failed
}

enum OutboxEventStatus {
  pending
  processing
  retry_wait
  processed
  dead_letter
}

enum MemoryScope {
  repository
  workspace
  user_prefs
}

enum MemoryItemStatus {
  active
  disabled
  expired
  deleted
}

enum MemoryIndexState {
  not_indexed
  index_pending
  indexed
  index_failed
  index_deleted
}

enum MemoryItemVisibility {
  repository_runtime
  workspace_runtime
  user_preference_runtime
}

enum MemoryRiskLevel {
  low
  medium
  high
  critical
}

enum MemorySuggestionStatus {
  pending
  confirmed
  rejected
  blocked
  expired
  superseded
}

enum ConflictReviewAttemptStatus {
  recorded
  dispatched
  started
  model_running
  posting_started
  summary_posted
  inline_posting_completed
  status_posted
  completed
  failed
  skipped
  stale
  degraded
  dead_letter
}

enum ConflictReviewPostingIntentStatus {
  pending
  completed
  failed
  ambiguous
}
