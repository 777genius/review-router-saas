generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                    WorkspaceMember[]
  installations              GitHubInstallation[]
  gitLabInstallations        GitLabInstallation[]
  repositories               RepositoryConnection[]
  provisioning               WorkflowProvisioning[]
  orgRulesets                OrgRulesetProvisioning[]
  reviewConfigs              ReviewConfiguration[]
  providerSetup              ProviderSetupState[]
  actionHealth               ActionRunHealthReport[]
  conflictReviewAttempts     ConflictReviewAttempt[]
  auditEvents                AuditEvent[]
  entitlement                WorkspaceEntitlement?
  memoryItems                MemoryItem[]
  memorySuggestions          MemorySuggestion[]
  memoryUsageEvents          MemoryUsageEvent[]
  codexOAuthProviders        CodexOAuthProviderInstance[]
  codexOAuthLeases           CodexOAuthLease[]
  codexOAuthSetupManifests   CodexOAuthSetupManifest[]
  reviewSnapshots            ReviewSnapshot[]
  reviewExecutionCheckpoints ReviewExecutionCheckpoint[]
}

model User {
  id           String   @id @default(cuid())
  githubUserId BigInt?  @unique
  githubLogin  String?
  primaryEmail String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                WorkspaceMember[]
  externalIdentities         UserExternalIdentity[]
  githubAuthorizations       GitHubUserAuthorization[]
  gitLabInstallations        GitLabInstallation[]
  repositoryPermissionCaches RepositoryPermissionCache[]
  memoryItems                MemoryItem[]
  memorySuggestions          MemorySuggestion[]

  @@index([githubLogin])
}

model UserExternalIdentity {
  id             String      @id @default(cuid())
  userId         String
  provider       ScmProvider
  externalUserId String
  login          String
  primaryEmail   String?
  avatarUrl      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalUserId])
  @@unique([userId, provider])
  @@index([provider, login])
}

model GitHubUserAuthorization {
  id                    String    @id @default(cuid())
  userId                String
  githubUserId          BigInt
  appSlug               String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  revokedAt             DateTime?
  lastErrorCode         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appSlug])
  @@index([githubUserId])
  @@index([revokedAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String?
  githubLogin String?
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, githubLogin])
  @@index([workspaceId, role])
}

model GitHubInstallation {
  id                   String                   @id @default(cuid())
  workspaceId          String
  githubInstallationId BigInt                   @unique
  accountLogin         String
  accountType          String
  accountAvatarUrl     String?
  repositorySelection  String
  status               GitHubInstallationStatus @default(active)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories RepositoryConnection[]
  orgRulesets  OrgRulesetProvisioning[]

  @@index([workspaceId, status])
}

model GitLabInstallation {
  id                String                   @id @default(cuid())
  workspaceId       String
  namespaceId       String?
  sourceBaseUrl     String                   @default("https://gitlab.com")
  namespacePath     String
  sourceKind        String
  status            GitLabInstallationStatus @default(active)
  installedByUserId String?
  selectedProjects  Int                      @default(0)
  installSummary    Json?
  lastInstalledAt   DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installedBy  User?                  @relation(fields: [installedByUserId], references: [id], onDelete: SetNull)
  repositories RepositoryConnection[]

  @@unique([workspaceId, sourceBaseUrl, namespacePath])
  @@index([workspaceId, status])
  @@index([namespaceId])
}

model RepositoryConnection {
  id                      String                @id @default(cuid())
  workspaceId             String
  provider                ScmProvider           @default(github)
  sourceBaseUrl           String                @default("https://github.com")
  externalRepositoryId    String
  scmRepositoryIdentityId String?
  installationId          String?
  githubRepositoryId      BigInt?               @unique
  gitlabInstallationId    String?
  owner                   String
  name                    String
  fullName                String
  defaultBranch           String
  visibility              RepositoryVisibility
  selected                Boolean               @default(true)
  archived                Boolean               @default(false)
  stargazersCount         Int                   @default(0)
  setupStatus             RepositorySetupStatus @default(not_configured)
  lastSyncedAt            DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  workspace                  Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation               GitHubInstallation?          @relation(fields: [installationId], references: [id], onDelete: Cascade)
  gitlabInstallation         GitLabInstallation?          @relation(fields: [gitlabInstallationId], references: [id], onDelete: Cascade)
  provisioning               WorkflowProvisioning[]
  reviewConfigs              ReviewConfiguration[]
  providerSetup              ProviderSetupState[]
  actionHealth               ActionRunHealthReport[]
  conflictReviewAttempts     ConflictReviewAttempt[]
  rulesetSources             OrgRulesetProvisioning[]     @relation("OrgRulesetSourceRepository")
  permissionCache            RepositoryPermissionCache[]
  memoryItems                MemoryItem[]
  memorySuggestions          MemorySuggestion[]
  memoryUsageEvents          MemoryUsageEvent[]
  codexOAuthProviders        CodexOAuthProviderInstance[]
  codexOAuthLeases           CodexOAuthLease[]
  codexOAuthSetupManifests   CodexOAuthSetupManifest[]
  reviewSnapshots            ReviewSnapshot[]
  reviewExecutionCheckpoints ReviewExecutionCheckpoint[]

  @@unique([provider, externalRepositoryId, sourceBaseUrl])
  @@unique([workspaceId, provider, fullName, sourceBaseUrl])
  @@unique([id, workspaceId, scmRepositoryIdentityId])
  @@index([installationId])
  @@index([gitlabInstallationId])
  @@index([workspaceId, setupStatus])
  @@index([workspaceId, provider, sourceBaseUrl, selected, fullName])
}

model RepositoryPermissionCache {
  id                   String   @id @default(cuid())
  userId               String
  repositoryId         String
  githubInstallationId BigInt
  permission           String?
  roleName             String?
  canManage            Boolean
  checkedAt            DateTime
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId, canManage, expiresAt])
  @@index([repositoryId])
  @@index([githubInstallationId])
}

model ReviewConfiguration {
  id           String   @id @default(cuid())
  workspaceId  String
  repositoryId String?
  targetKey    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection?        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  versions   ReviewConfigurationVersion[]

  @@unique([workspaceId, targetKey])
  @@index([workspaceId, repositoryId])
}

model ReviewConfigurationVersion {
  id                                      String   @id @default(cuid())
  configurationId                         String
  version                                 Int
  schemaVersion                           Int      @default(1)
  providerKind                            String
  providerAuthMode                        String
  model                                   String
  reasoningEffort                         String
  agenticContext                          Boolean  @default(true)
  fastMode                                Boolean  @default(false)
  failOnSeverity                          String
  inlineMaxComments                       Int
  providerLimit                           Int      @default(1)
  providerMaxParallel                     Int      @default(1)
  inlineMinAgreement                      Int      @default(1)
  targetTokensPerBatch                    Int
  reviewLanguage                          String?
  investigationRecordingEnabled           Boolean  @default(false)
  investigationShadowEnabled              Boolean  @default(false)
  investigationContextCriticEnabled       Boolean  @default(false)
  investigationVerifiedCleanEnabled       Boolean  @default(false)
  investigationCrossRevisionReplayEnabled Boolean  @default(false)
  investigationProductionEffectsEnabled   Boolean  @default(false)
  createdAt                               DateTime @default(now())

  configuration ReviewConfiguration                  @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  providers     ReviewConfigurationVersionProvider[]

  @@unique([configurationId, version])
  @@index([configurationId, createdAt])
}

model ReviewConfigurationVersionProvider {
  id                     String  @id @default(cuid())
  configurationVersionId String
  order                  Int
  providerKind           String
  providerAuthMode       String
  model                  String
  reasoningEffort        String
  agenticContext         Boolean @default(true)
  fastMode               Boolean @default(false)
  requiredHealthy        Boolean @default(false)

  configurationVersion ReviewConfigurationVersion @relation(fields: [configurationVersionId], references: [id], onDelete: Cascade)

  @@unique([configurationVersionId, order])
  @@index([configurationVersionId])
}

model ProviderSetupState {
  id           String              @id @default(cuid())
  workspaceId  String
  repositoryId String?
  targetKey    String
  providerKind String
  authMode     String
  state        ProviderSecretState @default(unknown)
  updatedAt    DateTime            @updatedAt
  createdAt    DateTime            @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, targetKey, providerKind, authMode])
  @@index([workspaceId, state])
}

model CodexOAuthProviderInstance {
  id                     String    @id @default(cuid())
  workspaceId            String
  repositoryId           String
  providerInstanceId     String    @unique
  authMode               String
  secretName             String
  state                  String    @default("setup_pending")
  latestGeneration       Int       @default(1)
  latestGenerationHash   String?
  generationHashSalt     String
  accountFingerprintSalt String
  activeLeaseId          String?
  activeLeaseExpiresAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository       RepositoryConnection        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  leases           CodexOAuthLease[]
  writebackIntents CodexOAuthWritebackIntent[]
  setupManifests   CodexOAuthSetupManifest[]

  @@unique([repositoryId, authMode])
  @@index([workspaceId, state])
  @@index([repositoryId, state])
  @@index([activeLeaseExpiresAt])
}

model CodexOAuthSetupManifest {
  id                    String    @id @default(cuid())
  workspaceId           String
  repositoryId          String
  providerInstanceRowId String
  providerInstanceId    String
  setupNonce            String    @unique
  manifestJson          Json
  status                String    @default("issued")
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  lastFetchedAt         DateTime?
  consumedAt            DateTime?
  confirmationJson      Json?

  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository       RepositoryConnection       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  providerInstance CodexOAuthProviderInstance @relation(fields: [providerInstanceRowId], references: [id], onDelete: Cascade)

  @@index([repositoryId, status])
  @@index([providerInstanceId, status])
  @@index([expiresAt])
}

model CodexOAuthLease {
  id                      String    @id @default(cuid())
  providerInstanceRowId   String
  providerInstanceId      String
  workspaceId             String
  repositoryId            String
  githubRunId             String
  githubRunAttempt        String
  pullRequestNumber       Int?
  leaseKey                String    @unique
  status                  String    @default("preleased")
  restoredGenerationHash  String?
  nextGeneration          Int?
  writebackPreflightKeyId String?
  writebackPreflightedAt  DateTime?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  finalizedAt             DateTime?
  completedAt             DateTime?

  providerInstance CodexOAuthProviderInstance  @relation(fields: [providerInstanceRowId], references: [id], onDelete: Cascade)
  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository       RepositoryConnection        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  writebackIntents CodexOAuthWritebackIntent[]

  @@index([providerInstanceId, status])
  @@index([workspaceId, status])
  @@index([repositoryId, status])
  @@index([expiresAt])
}

model CodexOAuthWritebackIntent {
  id                     String    @id @default(cuid())
  providerInstanceRowId  String
  leaseId                String
  providerInstanceId     String
  idempotencyKey         String
  generation             Int
  latestGenerationHash   String
  encryptedPayloadDigest String
  keyId                  String
  status                 String    @default("pending")
  safeErrorCode          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?

  providerInstance CodexOAuthProviderInstance @relation(fields: [providerInstanceRowId], references: [id], onDelete: Cascade)
  lease            CodexOAuthLease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@unique([providerInstanceId, idempotencyKey])
  @@index([providerInstanceId, status])
  @@index([leaseId, status])
}

model ActionRunHealthReport {
  id                    String               @id @default(cuid())
  workspaceId           String
  repositoryId          String
  githubRunId           String
  githubRunAttempt      String
  eventName             String
  actionVersion         String
  configVersion         Int
  configSource          String?
  providerSetupState    ProviderSecretState
  providerHealth        ActionProviderHealth
  safeErrorCategory     String
  safeErrorSummary      String?
  findingCriticalCount  Int?
  findingMajorCount     Int?
  findingMinorCount     Int?
  findingInfoCount      Int?
  inlineCommentCount    Int?
  summaryCommentCount   Int?
  skippedReasonCategory String?
  startedAt             DateTime?
  finishedAt            DateTime?
  receivedAt            DateTime
  createdAt             DateTime             @default(now())

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, githubRunId, githubRunAttempt])
  @@index([workspaceId, receivedAt])
}

model ReviewSnapshot {
  id                        String   @id @default(cuid())
  workspaceId               String
  repositoryId              String
  pullRequestNumber         Int
  version                   Int      @default(1)
  schemaVersion             Int      @default(1)
  reviewedHeadSha           String
  baseSha                   String
  compatibilityKey          String
  payload                   Json
  payloadHash               String
  sourceRunId               String
  sourceRunAttempt          String
  scmRepositoryIdentityId   String?
  sourceExecutionId         String?
  sourceExecutionGeneration BigInt?
  sourceArtifactHash        String?
  sourceReviewRevisionHash  String?
  publicationReceiptSetHash String?
  reviewedAt                DateTime
  expiresAt                 DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository RepositoryConnection @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, repositoryId, pullRequestNumber])
  @@index([expiresAt, id])
  @@index([workspaceId, expiresAt])
  @@index([repositoryId, expiresAt])
  @@index([sourceExecutionId])
}

model ReviewExecutionCheckpoint {
  id                String                         @id @default(cuid())
  workspaceId       String
  repositoryId      String
  pullRequestNumber Int
  version           Int                            @default(1)
  state             ReviewExecutionCheckpointState @default(active)
  schemaVersion     Int                            @default(1)
  baseSha           String
  headSha           String
  compatibilityKey  String
  planHash          String
  plannedWorkKeys   String[]
  acceptedBytes     Int                            @default(0)
  acceptedFindings  Int                            @default(0)
  sourceRunId       String
  sourceRunAttempt  String
  updatedAt         DateTime                       @default(now()) @updatedAt
  expiresAt         DateTime
  finalizedAt       DateTime?
  createdAt         DateTime                       @default(now())

  workspace    Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   RepositoryConnection         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  batchResults ReviewExecutionBatchResult[]

  @@unique([workspaceId, repositoryId, pullRequestNumber])
  @@index([expiresAt, id])
  @@index([workspaceId, expiresAt])
  @@index([repositoryId, expiresAt])
}

model ReviewExecutionBatchResult {
  id               String   @id @default(cuid())
  checkpointId     String
  workKey          String
  batchId          String
  batchIndex       Int
  payload          Json
  payloadHash      String
  byteCount        Int
  sourceRunId      String
  sourceRunAttempt String
  completedAt      DateTime

  checkpoint ReviewExecutionCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([checkpointId, workKey])
  @@index([checkpointId, batchIndex])
}

model ReviewProtocolLimitsV2 {
  protocolLimitsProfileId     String   @id
  limitsDigest                String   @unique
  maxWorkSlots                Int
  maxAttemptsPerSlot          Int
  maxObservationBytes         Int
  maxObservationFindings      Int
  maxProjectionBytes          Int
  maxProjectionFindings       Int
  maxPublicationOperations    Int
  maxPublicationChunks        Int
  maxPublicationBodyBytes     Int
  maxRequestBatchSize         Int
  maxLeaseDurationMs          Int
  maxResultReportDurationMs   Int
  maxReconciliationDurationMs Int
  registeredAt                DateTime

  @@index([registeredAt, protocolLimitsProfileId])
}

model ReviewOperationalSloProfileV2 {
  operationalSloProfileId     String   @id
  sloDigest                   String   @unique
  integrationEventDeliveryMs  Int
  outboxClaimAgeMs            Int
  missingCompletionProcessMs  Int
  dueCompletionProcessMs      Int
  publicationReconciliationMs Int
  v1DrainMs                   Int
  admissionMs                 Int
  pruningBacklogAgeMs         Int
  ownerRefs                   String[]
  runbookRefs                 String[]
  registeredAt                DateTime

  @@index([registeredAt, operationalSloProfileId])
}

model ProducerRelease {
  producerReleaseId                      String                     @id
  distributionKind                       ProducerDistributionKindV2
  actionCommitSha                        String
  runtimeCommitSha                       String
  wrapperEntrypointDigest                String?
  runtimeEntrypointDigest                String
  contextGatewayPolicyVersion            String?
  contextGatewayEntrypointDigest         String?
  reviewInvestigationCapability          String?
  reviewInvestigationCoverageProfileHash String?
  reviewInvestigationPolicyHash          String?
  schemaDigest                           String
  capabilityProfile                      String
  protocolLimitsProfileId                String
  operationalSloProfileId                String
  state                                  ProducerReleaseStateV2     @default(registered)
  registeredAt                           DateTime
  revokedAt                              DateTime?

  @@unique([distributionKind, actionCommitSha, runtimeCommitSha, wrapperEntrypointDigest, runtimeEntrypointDigest, contextGatewayPolicyVersion, contextGatewayEntrypointDigest, reviewInvestigationCapability, reviewInvestigationCoverageProfileHash, reviewInvestigationPolicyHash, schemaDigest, capabilityProfile, protocolLimitsProfileId, operationalSloProfileId])
  @@index([state, registeredAt])
}

model ScmRepositoryIdentity {
  scmRepositoryIdentityId       String      @id
  provider                      ScmProvider
  normalizedSourceBaseUrl       String
  externalRepositoryId          String
  version                       Int         @default(1)
  currentWorkspaceId            String?
  currentRepositoryConnectionId String?
  createdAt                     DateTime
  boundAt                       DateTime?
  unboundAt                     DateTime?

  @@unique([provider, normalizedSourceBaseUrl, externalRepositoryId])
  @@unique([currentRepositoryConnectionId])
  @@index([currentWorkspaceId, currentRepositoryConnectionId])
}

model ReviewMutationAuthority {
  scmRepositoryIdentityId      String
  laneKind                     ReviewMutationLaneKindV2
  version                      Int                      @default(1)
  epoch                        BigInt                   @default(0)
  mode                         ReviewMutationModeV2
  drainPolicyVersion           Int?
  drainStartedAt               DateTime?
  v1AdmissionClosedAt          DateTime?
  drainNotBefore               DateTime?
  managedWorkflowInventoryHash String?
  activationSafetyDecisionHash String?
  initializedAt                DateTime
  activatedAt                  DateTime?
  pausedAt                     DateTime?

  @@id([scmRepositoryIdentityId, laneKind])
  @@index([mode, drainNotBefore])
}

model ReviewSafetyPolicy {
  policyId                String                    @id
  policyScope             ReviewSafetyPolicyScopeV2
  capability              ReviewSafetyCapabilityV2
  workspaceId             String?
  repositoryConnectionId  String?
  scmRepositoryIdentityId String?
  version                 Int                       @default(1)
  rolloutMode             ReviewSafetyRolloutModeV2 @default(disabled)
  updatedBy               String
  updatedAt               DateTime

  @@unique([policyScope, capability, workspaceId, repositoryConnectionId, scmRepositoryIdentityId])
  @@index([workspaceId, repositoryConnectionId, capability])
}

model ReviewSafetyPolicySelector {
  policyId        String
  selectorOrdinal Int
  providerKind    ReviewProviderKindV2?
  taskKind        ReviewTaskKindV2?

  @@id([policyId, selectorOrdinal])
  @@unique([policyId, providerKind, taskKind])
}

model ReviewSafetyEmergencyControl {
  emergencyControlId      String                    @id
  policyScope             ReviewSafetyPolicyScopeV2
  workspaceId             String?
  repositoryConnectionId  String?
  scmRepositoryIdentityId String?
  version                 Int                       @default(1)
  stopped                 Boolean                   @default(true)
  reason                  String
  updatedBy               String
  updatedAt               DateTime

  @@unique([policyScope, workspaceId, repositoryConnectionId, scmRepositoryIdentityId])
  @@index([stopped, updatedAt])
}

model ReviewRunAuthorization {
  authorizationId                                         String                        @id
  version                                                 Int                           @default(1)
  workspaceId                                             String
  repositoryConnectionId                                  String
  scmRepositoryIdentityId                                 String
  pullRequestNumber                                       Int
  sourceRunId                                             String
  sourceRunAttempt                                        String
  workflowIdentityHash                                    String
  baseSha                                                 String
  mergeBaseSha                                            String
  headSha                                                 String
  reviewRevisionHash                                      String
  trustDomain                                             ReviewTrustDomainV2
  producerReleaseId                                       String
  selectedProtocolVersion                                 String
  schemaDigest                                            String
  protocolLimitsProfileId                                 String
  operationalSloProfileId                                 String
  mutationEpoch                                           BigInt
  providerVoteLanes                                       Json
  reviewInvestigationAuthorizationDescriptorCanonicalJson String?
  authorizationSafetyDecisionHash                         String
  protocolOfferHash                                       String
  oidcReplayKeyHash                                       String                        @unique
  tokenSigningKeyId                                       String
  tokenIssuer                                             String
  tokenAudience                                           String
  state                                                   ReviewRunAuthorizationStateV2 @default(active)
  expiresAt                                               DateTime
  maxExpiresAt                                            DateTime
  createdAt                                               DateTime
  renewedAt                                               DateTime?
  revokedAt                                               DateTime?

  @@unique([workspaceId, repositoryConnectionId, scmRepositoryIdentityId, sourceRunId, sourceRunAttempt, protocolOfferHash])
  @@index([repositoryConnectionId, pullRequestNumber, state, expiresAt])
  @@index([producerReleaseId, state])
}

model ReviewRunAuthorizationRenewalReceipt {
  renewalReplayKeyHash String    @id
  authorizationId      String
  renewalProofHash     String
  authorizationVersion Int
  renewedExpiresAt     DateTime
  renewedAt            DateTime?
  createdAt            DateTime  @default(now())

  @@index([authorizationId, createdAt])
  @@index([createdAt, renewalReplayKeyHash])
}

model ReviewEvidenceObservation {
  observationId                    String                              @id
  workspaceId                      String
  repositoryConnectionId           String
  scmRepositoryIdentityId          String
  pullRequestNumber                Int
  manifestKey                      String
  providerInvocationKey            String
  providerVoteIdentityHash         String
  manifestVersion                  Int
  providerKind                     ReviewProviderKindV2
  requestedModel                   String
  actualModel                      String
  providerRuntimeVersion           String
  taskKindSet                      ReviewTaskKindV2[]
  producerReleaseId                String
  selectedProtocolVersion          String
  trustedCapabilityProfile         String
  executionProfile                 ProviderExecutionProfileV2
  trustDomain                      ReviewTrustDomainV2
  authorizationScopeHash           String
  sourceBaseSha                    String
  sourceMergeBaseSha               String
  sourceHeadSha                    String
  sourceReviewRevisionHash         String
  sourcePlanHash                   String
  sourceExecutionId                String
  sourceWorkSlotId                 String
  sourceAuthorizationId            String
  evidenceWriteSafetyDecisionHash  String
  sourceRunId                      String
  sourceRunAttempt                 String
  attemptId                        String
  sourceLeaseId                    String
  sourceFencingToken               BigInt
  payloadJson                      Json
  payloadHash                      String
  byteCount                        Int
  findingCount                     Int
  qualityFlagsJson                 Json
  transportAttemptCount            Int
  contextDependencyAttestationId   String?
  contextDependencyAttestationHash String?
  investigationCertificateId       String?
  investigationCertificateHash     String?
  createdAt                        DateTime
  reuseExpiresAt                   DateTime
  retainUntil                      DateTime
  contextDependencyAttestation     ReviewContextDependencyAttestation? @relation(fields: [contextDependencyAttestationId], references: [attestationId], onDelete: Restrict)

  @@unique([sourceExecutionId, providerVoteIdentityHash, attemptId])
  @@index([workspaceId, repositoryConnectionId, scmRepositoryIdentityId, pullRequestNumber, trustDomain, providerInvocationKey, reuseExpiresAt])
  @@index([reuseExpiresAt, observationId])
  @@index([retainUntil, observationId])
  @@index([sourceExecutionId])
  @@index([contextDependencyAttestationId])
  @@index([investigationCertificateId])
}

model ReviewInvestigationShadowEvidence {
  shadowEvidenceId                 String                                  @id
  evidenceVersion                  Int
  authority                        InvestigationShadowEvidenceAuthorityV1
  sourceKind                       InvestigationShadowEvidenceSourceKindV1
  retentionPolicyVersion           String
  investigationId                  String                                  @unique(map: "ReviewInvestigationShadowEvidence_investigation_key")
  investigationVersion             BigInt
  workspaceId                      String
  repositoryConnectionId           String
  scmRepositoryIdentityId          String
  pullRequestNumber                Int
  trustDomain                      ReviewTrustDomainV2
