{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXTAUTH_URL",
        "REVIEW_ROUTER_API_URL",
        "REVIEW_ROUTER_PUBLIC_API_URL",
        "REVIEW_ROUTER_PUBLIC_WEB_URL",
        "REVIEW_ROUTER_WEB_URL"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "build:contract-source": {
      "outputs": ["dist/contract-source/**", "dist/v2/contract-source/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
