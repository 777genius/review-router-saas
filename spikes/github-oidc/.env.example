# Optional. If omitted, scripts try ~/.config/review-router/apps/review-router-ai.env
REVIEW_ROUTER_APP_PROFILE=~/.config/review-router/apps/review-router-ai.env

# For server/OIDC spike
REVIEW_ROUTER_SPIKE_PORT=8787
REVIEW_ROUTER_OIDC_AUDIENCE=review-router-spike
REVIEW_ROUTER_ACTION_SESSION_SECRET=replace-with-random-32-byte-secret

# Optional hard binding for OIDC exchange during real test
REVIEW_ROUTER_ALLOWED_REPOSITORY_ID=
REVIEW_ROUTER_ALLOW_MOCK_OIDC=0

# For create setup PR script
REVIEW_ROUTER_TARGET_REPO=owner/repo
REVIEW_ROUTER_INSTALLATION_ID=
REVIEW_ROUTER_SETUP_BRANCH=reviewrouter/saas-spike
REVIEW_ROUTER_SETUP_AUTH=app
REVIEW_ROUTER_SPIKE_PUBLIC_URL=
