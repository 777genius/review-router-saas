# ReviewRouter self-hosted control plane for github.com.
# Copy this file to deploy/self-hosted/.env and replace every placeholder.

NODE_ENV=production
AUTH_TRUST_HOST=true

# Local container database. Keep DATABASE_URL in sync with POSTGRES_*.
POSTGRES_DB=review_router
POSTGRES_USER=reviewrouter
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://reviewrouter:replace-with-strong-postgres-password@postgres:5432/review_router?schema=public

# Bind only to localhost by default. Put Caddy, Nginx, Traefik, or a load
# balancer in front and terminate public HTTPS there.
REVIEW_ROUTER_WEB_BIND=127.0.0.1:3000
REVIEW_ROUTER_API_BIND=127.0.0.1:4000
REVIEW_ROUTER_POSTGRES_BIND=127.0.0.1:5432

# Public URLs. GitHub App callback/setup/webhook URLs must match these hosts.
REVIEW_ROUTER_WEB_URL=https://reviewrouter.example.com
REVIEW_ROUTER_API_URL=https://api.reviewrouter.example.com
REVIEW_ROUTER_PUBLIC_WEB_URL=https://reviewrouter.example.com
REVIEW_ROUTER_PUBLIC_API_URL=https://api.reviewrouter.example.com
NEXTAUTH_URL=https://reviewrouter.example.com

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-strong-random-secret-min-32
REVIEW_ROUTER_ACTION_SESSION_SECRET=replace-with-strong-random-secret-min-32
REVIEW_ROUTER_TOKEN_ENCRYPTION_KEY=replace-with-strong-random-secret-min-32

# GitHub App OAuth/client/webhook credentials for your self-hosted instance.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
REVIEW_ROUTER_GITHUB_APP_PERMISSION_PROFILE=managed-review

# Compatibility aliases used by some operator scripts. Set them to the same
# values as GITHUB_APP_CLIENT_ID and GITHUB_APP_CLIENT_SECRET.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Preferred for Docker env files: paste the PEM with escaped newlines.
# Example: -----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_APP_PRIVATE_KEY=
# Alternative only if you mount a file into the containers.
GITHUB_APP_PRIVATE_KEY_FILE=

# Control plane features.
REVIEW_ROUTER_ENABLE_DASHBOARD_MUTATIONS=1
REVIEW_ROUTER_ENABLE_WORKFLOW_PROVISIONING=0
REVIEW_ROUTER_DISABLE_WORKFLOW_PROVISIONING=1
REVIEW_ROUTER_DISABLE_ACTION_CONTROL_PLANE=0
REVIEW_ROUTER_ACTION_OIDC_AUDIENCE=reviewrouter
REVIEW_ROUTER_ACTION_REF=777genius/review-router@v1
REVIEW_ROUTER_ALLOWED_ACTION_REFS=
REVIEW_ROUTER_BLOCKED_ACTION_VERSIONS=
# Authoritative server-side ceiling evaluated before OAuth or provider work.
REVIEW_ROUTER_HOSTED_MAX_CHANGED_LINES=250000

# Provider credentials stay in customer GitHub Actions secrets, never here.
REVIEW_ROUTER_ENABLE_CODEX_ROTATING_OAUTH=1
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=
REVIEW_ROUTER_DEFAULT_MODEL=gpt-5.5
REVIEW_ROUTER_DEFAULT_EFFORT=medium
REVIEW_ROUTER_ENABLE_CONFLICT_REVIEW_FALLBACK=1
REVIEW_ROUTER_CONFLICT_REVIEW_FALLBACK_REPOSITORIES=

# Worker tuning.
REVIEW_ROUTER_OUTBOX_BATCH_SIZE=25
REVIEW_ROUTER_OUTBOX_PROCESSING_STALE_MS=900000
REVIEW_ROUTER_WORKER_IDLE_MS=5000
REVIEW_ROUTER_WORKER_BUSY_MS=250
REVIEW_ROUTER_WORKER_ERROR_MS=5000
REVIEW_ROUTER_MAX_REPOSITORIES_PER_SYNC=250
