# ReviewRouter self-hosted control plane for github.com.
# Copy this file to deploy/self-hosted/.env and replace every placeholder.

NODE_ENV=production
AUTH_TRUST_HOST=true

# Local container database. Keep DATABASE_URL in sync with POSTGRES_*.
POSTGRES_DB=review_router
POSTGRES_USER=reviewrouter
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://reviewrouter:replace-with-strong-postgres-password@postgres:5432/review_router?schema=public

# Bind only to localhost by default. Put Caddy, Nginx, Traefik, or a load
# balancer in front and terminate public HTTPS there.
REVIEW_ROUTER_WEB_BIND=127.0.0.1:3000
REVIEW_ROUTER_API_BIND=127.0.0.1:4000
REVIEW_ROUTER_POSTGRES_BIND=127.0.0.1:5432

# Public URLs. GitHub App callback/setup/webhook URLs must match these hosts.
REVIEW_ROUTER_WEB_URL=https://reviewrouter.example.com
REVIEW_ROUTER_API_URL=https://api.reviewrouter.example.com
REVIEW_ROUTER_PUBLIC_WEB_URL=https://reviewrouter.example.com
REVIEW_ROUTER_PUBLIC_API_URL=https://api.reviewrouter.example.com
NEXTAUTH_URL=https://reviewrouter.example.com

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-strong-random-secret-min-32
REVIEW_ROUTER_ACTION_SESSION_SECRET=replace-with-strong-random-secret-min-32
REVIEW_ROUTER_TOKEN_ENCRYPTION_KEY=replace-with-strong-random-secret-min-32

# GitHub App OAuth/client/webhook credentials for your self-hosted instance.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
REVIEW_ROUTER_GITHUB_APP_PERMISSION_PROFILE=review-only

# Compatibility aliases used by some operator scripts. Set them to the same
# values as GITHUB_APP_CLIENT_ID and GITHUB_APP_CLIENT_SECRET.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Preferred for Docker env files: paste the PEM with escaped newlines.
# Example: -----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_APP_PRIVATE_KEY=
# Alternative only if you mount a file into the containers.
GITHUB_APP_PRIVATE_KEY_FILE=

# Control plane features.
REVIEW_ROUTER_ENABLE_DASHBOARD_MUTATIONS=1
REVIEW_ROUTER_ENABLE_WORKFLOW_PROVISIONING=0
REVIEW_ROUTER_DISABLE_WORKFLOW_PROVISIONING=1
REVIEW_ROUTER_DISABLE_ACTION_CONTROL_PLANE=0
REVIEW_ROUTER_ACTION_OIDC_AUDIENCE=reviewrouter
REVIEW_ROUTER_ACTION_REF=777genius/review-router@replace-with-40-character-action-commit-sha
REVIEW_ROUTER_ALLOWED_ACTION_REFS=
# Rotating namespaces use their own exact Action SHA. Existing active
# namespaces stay pinned during an A -> B overlap; new setup candidates use the
# primary SHA.
REVIEW_ROUTER_CODEX_ROTATING_ACTION_REF=777genius/review-router@replace-with-40-character-action-commit-sha
REVIEW_ROUTER_CODEX_ROTATING_ALLOWED_ACTION_REFS=
# Atomic installer release tuple. The URL must use the exact Action SHA above.
# Copy all three values from one published release descriptor artifact.
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_URL=https://raw.githubusercontent.com/777genius/review-router/replace-with-40-character-action-commit-sha/scripts/seed-codex-rotating-auth.sh
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_VERSION=replace-with-exact-v1.0.0-release
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_SHA256=replace-with-64-character-seed-installer-sha256
# One shared unpadded base64url secret, generated from at least 32 random bytes.
REVIEW_ROUTER_DATABASE_RECOVERY_WITNESS=replace-with-base64url-database-recovery-witness
REVIEW_ROUTER_BLOCKED_ACTION_VERSIONS=
# Authoritative server-side ceiling evaluated before OAuth or provider work.
REVIEW_ROUTER_HOSTED_MAX_CHANGED_LINES=250000

# Direct client-triggered T0 runtime. Both opt-ins are mandatory. Server-side
# intent admission, ingress, and workflow dispatch are incompatible with this
# mode and must remain disabled.
REVIEW_ROUTER_REVIEW_V2_DIRECT_INITIALIZATION_ENABLED=1
REVIEW_ROUTER_REVIEW_V2_WORKFLOW_PROVISIONING_MODE=client_triggered_t0
REVIEW_ROUTER_REVIEW_V2_RUN_CONTROL_ENABLED=1
REVIEW_ROUTER_REVIEW_V2_WORKER_ENABLED=1
REVIEW_ROUTER_PROGRESS_PROJECTION_CAPTURE=0
REVIEW_ROUTER_PROGRESS_FILE_COVERAGE=0
REVIEW_ROUTER_HOSTED_PROGRESS_COMMENT_WRITES=0
# Required before hosted writes start. Use comma-separated owner/repo canaries;
# use * only after the rollout gates pass.
REVIEW_ROUTER_PROGRESS_REPOSITORIES=
REVIEW_ROUTER_REVIEW_V2_INTENT_INGRESS_ENABLED=0
REVIEW_ROUTER_REVIEW_V2_INTENT_ADMISSION_REQUIRED=0
REVIEW_ROUTER_REVIEW_V2_WORKFLOW_DISPATCH_READY=0
REVIEW_ROUTER_OUTBOX_FENCED_TAKEOVER_ENABLED=1

# Independent rotating key rings for run authorization and Review v2
# capabilities. Each JSON value is a non-empty array of:
# {"keyId":"...","secretBase64":"...","verifyUntil":null}
REVIEW_ROUTER_REVIEW_RUN_AUTHORIZATION_ACTIVE_KEY_ID=
REVIEW_ROUTER_REVIEW_RUN_AUTHORIZATION_KEYS_JSON=
REVIEW_ROUTER_REVIEW_V2_CAPABILITY_ACTIVE_KEY_ID=
REVIEW_ROUTER_REVIEW_V2_CAPABILITY_KEYS_JSON=

# Use the maintainer-validated release bundle for attestations and provider
# vote lanes. Do not copy synthetic digests from tests. The attestation
# actionCommitSha must equal the bare 40-character commit component of
# REVIEW_ROUTER_ACTION_REF; both must identify the same commit.
# Attestation fields:
# producerReleaseId, distributionKind=public_reusable, actionCommitSha,
# runtimeCommitSha, wrapperEntrypointDigest, runtimeEntrypointDigest,
# contextGatewayPolicyVersion, contextGatewayEntrypointDigest, schemaDigest,
# canonicalizerDigest, capabilityProfile=exact_revision_v2,
# protocolLimitsProfileId, operationalSloProfileId.
REVIEW_ROUTER_REVIEW_V2_PRODUCER_RELEASE_ATTESTATIONS_JSON=
# Provider lane fields: providerKind=codex, providerVoteIdentityHash=64hex.
REVIEW_ROUTER_REVIEW_V2_PROVIDER_VOTE_LANES_JSON=
REVIEW_ROUTER_REVIEW_V2_PROJECTION_POLICY_VERSION=review-projection-policy.v5-t0

# API-only context keys. The session key is a 32-byte base64 value. Replay keys
# are a non-empty array of {"keyId":"...","secretBase64":"..."}.
REVIEW_ROUTER_REVIEW_V2_CONTEXT_SESSION_SECRET_BASE64=
REVIEW_ROUTER_REVIEW_V2_CONTEXT_REPLAY_ACTIVE_KEY_ID=
REVIEW_ROUTER_REVIEW_V2_CONTEXT_REPLAY_KEYS_JSON=

# SHA-256 of the operator credential. Do not store the plaintext credential in
# this shared env file.
REVIEW_ROUTER_REVIEW_V2_OPERATOR_CREDENTIAL_SHA256=
# Independent, lower-privilege credential for remote review-config reads and
# reasoning-effort updates. Do not reuse the Review v2 credential.
REVIEW_ROUTER_REVIEW_CONFIG_OPERATOR_CREDENTIAL_SHA256=
# Optional JSON array of trusted Ed25519 evaluation public keys.
REVIEW_ROUTER_INVESTIGATION_EVALUATION_PUBLIC_KEYS_JSON=
REVIEW_ROUTER_INVESTIGATION_PROMOTION_CREDENTIAL_SHA256=
REVIEW_ROUTER_INVESTIGATION_EVALUATION_IMPORT_CREDENTIAL_SHA256=
# JSON array of authoritative {identity,trustProfile,thresholds} profiles.
REVIEW_ROUTER_INVESTIGATION_PROMOTION_POLICY_PROFILES_JSON=
# Dormant until an approved promotion report and explicit cohort exist.
REVIEW_ROUTER_REVIEW_INVESTIGATION_RECORDING_ENABLED=0
# Required before recording is enabled. Use an independent rotating keyring:
# [{"keyId":"...","secretBase64":"...","verifyUntil":null}].
REVIEW_ROUTER_REVIEW_INVESTIGATION_LEASE_CAPABILITY_ACTIVE_KEY_ID=
REVIEW_ROUTER_REVIEW_INVESTIGATION_LEASE_CAPABILITY_KEYS_JSON=
REVIEW_ROUTER_REVIEW_INVESTIGATION_SHADOW_ENABLED=0
REVIEW_ROUTER_REVIEW_INVESTIGATION_CONTEXT_CRITIC_ENABLED=0
REVIEW_ROUTER_REVIEW_INVESTIGATION_VERIFIED_CLEAN_ENABLED=0
REVIEW_ROUTER_REVIEW_INVESTIGATION_CROSS_REVISION_REPLAY_ENABLED=0
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRODUCTION_EFFECTS_ENABLED=0
REVIEW_ROUTER_REVIEW_INVESTIGATION_EMERGENCY_DISABLED=0
REVIEW_ROUTER_REVIEW_INVESTIGATION_SELECTORS_JSON=

# Provider credentials stay in customer GitHub Actions secrets, never here.
REVIEW_ROUTER_ENABLE_CODEX_ROTATING_OAUTH=1
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=
REVIEW_ROUTER_DEFAULT_MODEL=gpt-5.5
REVIEW_ROUTER_DEFAULT_EFFORT=xhigh
REVIEW_ROUTER_ENABLE_CONFLICT_REVIEW_FALLBACK=1
REVIEW_ROUTER_CONFLICT_REVIEW_FALLBACK_REPOSITORIES=

# Worker tuning.
REVIEW_ROUTER_OUTBOX_BATCH_SIZE=25
REVIEW_ROUTER_OUTBOX_PROCESSING_STALE_MS=900000
REVIEW_ROUTER_WORKER_IDLE_MS=5000
REVIEW_ROUTER_WORKER_BUSY_MS=250
REVIEW_ROUTER_WORKER_ERROR_MS=5000
REVIEW_ROUTER_MAX_REPOSITORIES_PER_SYNC=250
# Required before investigation recording can accept private search queries.
# Resolve both key settings from a secret file/store, never commit key material.
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_ACTIVE_KEY_ID=
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_KEYS_JSON=
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_TTL_MS=86400000
# Required when investigation recording is enabled, after migrations deploy.
# Batch sizes are capped at 1000; live evidence prevents premature pruning.
REVIEW_ROUTER_REVIEW_INVESTIGATION_MAINTENANCE_ENABLED=0
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_PRUNE_BATCH_SIZE=100
REVIEW_ROUTER_REVIEW_INVESTIGATION_DOSSIER_PRUNE_BATCH_SIZE=100
REVIEW_ROUTER_REVIEW_INVESTIGATION_SHADOW_EVIDENCE_PRUNE_BATCH_SIZE=100
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRUNE_INTERVAL_MS=3600000
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRUNE_LOCK_TTL_MS=300000
