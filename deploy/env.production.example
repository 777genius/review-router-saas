# ReviewRouter production/staging environment template.
# Store these in your host secret manager. Do not commit real values.

NODE_ENV="production"

# Managed Postgres. Use direct connection for Prisma migrations and runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/review_router?schema=public"

# Public URLs. GitHub App callback/setup/webhook URLs must match these hosts.
REVIEW_ROUTER_WEB_URL="https://reviewrouter.example.com"
REVIEW_ROUTER_API_URL="https://api.reviewrouter.example.com"
NEXTAUTH_URL="https://reviewrouter.example.com"
# URL embedded into generated GitHub Actions workflows. Must be public HTTPS in production.
REVIEW_ROUTER_PUBLIC_API_URL="https://api.reviewrouter.example.com"

# Auth.js / NextAuth. Use at least 32 random bytes for AUTH_SECRET.
AUTH_SECRET="replace-with-strong-random-secret"
AUTH_TRUST_HOST="true"

# GitHub OAuth / GitHub App.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
# Encrypts GitHub App user access tokens for maintainer repository discovery.
REVIEW_ROUTER_TOKEN_ENCRYPTION_KEY="replace-with-strong-random-secret-min-32"
# Preferred for hosted deploys. Paste the PEM as a secret value; escaped \n is supported.
GITHUB_APP_PRIVATE_KEY=""
# Alternative for file-mounted secrets.
# GITHUB_APP_PRIVATE_KEY_FILE="/run/secrets/reviewrouter-github-app.pem"
GITHUB_WEBHOOK_SECRET="replace-with-github-webhook-secret"

# Action control plane. Keep enabled for SaaS-managed setup PRs.
REVIEW_ROUTER_ENABLE_DASHBOARD_MUTATIONS="1"
REVIEW_ROUTER_ENABLE_WORKFLOW_PROVISIONING="1"
REVIEW_ROUTER_DISABLE_WORKFLOW_PROVISIONING="0"
REVIEW_ROUTER_DISABLE_ACTION_CONTROL_PLANE="0"
# Production workflows default to the live Action runtime for fastest review fixes.
# Use a full commit SHA only for deliberate rollback or smoke testing.
REVIEW_ROUTER_ACTION_REF="777genius/review-router@main"
REVIEW_ROUTER_ACTION_OIDC_AUDIENCE="reviewrouter"
REVIEW_ROUTER_ACTION_SESSION_SECRET="replace-with-strong-random-secret-min-32"
REVIEW_ROUTER_BLOCKED_ACTION_VERSIONS=""
# Authoritative server-side ceiling evaluated before OAuth or provider work.
REVIEW_ROUTER_HOSTED_MAX_CHANGED_LINES="250000"
REVIEW_ROUTER_ENABLE_CODEX_ROTATING_OAUTH="1"
# Empty means all repositories. Set to comma-separated owner/repo values only
# for a temporary production rollback/limited rollout.
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=""

# Review defaults for newly configured repositories.
REVIEW_ROUTER_DEFAULT_MODEL="gpt-5.5"
REVIEW_ROUTER_DEFAULT_EFFORT="xhigh"
REVIEW_ROUTER_ENABLE_CONFLICT_REVIEW_FALLBACK="1"
# Empty means all repositories. Set to comma-separated owner/repo values to
# temporarily restrict rollout.
REVIEW_ROUTER_CONFLICT_REVIEW_FALLBACK_REPOSITORIES=""

# Worker tuning.
REVIEW_ROUTER_OUTBOX_BATCH_SIZE="25"
REVIEW_ROUTER_OUTBOX_PROCESSING_STALE_MS="900000"
REVIEW_ROUTER_WORKER_IDLE_MS="5000"
REVIEW_ROUTER_WORKER_BUSY_MS="250"
REVIEW_ROUTER_WORKER_ERROR_MS="5000"
REVIEW_ROUTER_MAX_REPOSITORIES_PER_SYNC="250"
