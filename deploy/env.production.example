# ReviewRouter production/staging environment template.
# Store these in your host secret manager. Do not commit real values.

NODE_ENV="production"

# Managed Postgres. Use direct connection for Prisma migrations and runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/review_router?schema=public"
REVIEW_ROUTER_CODEX_EFFECT_AUTHORITY_DATABASE_URL="postgresql://reviewrouter_codex_effect_authority:PASSWORD@HOST:5432/review_router?schema=public"

# Private PG17 cutover values belong to protected GitHub environments, not the
# runtime Render environment group. The dedicated runner-base service must not
# receive this file or any DATABASE_URL. See operations runbook 14.
# REVIEW_ROUTER_SOURCE_DATABASE_URL="postgresql://SOURCE_COPY_ROLE:PASSWORD@PRIVATE_PG16/review_router"
# REVIEW_ROUTER_ROLE_BOOTSTRAP_DATABASE_URL="postgresql://reviewrouter_role_bootstrap:PASSWORD@PRIVATE_PG17/review_router"
# REVIEW_ROUTER_RELEASE_MIGRATION_DATABASE_URL="postgresql://reviewrouter_release_migration:PASSWORD@PRIVATE_PG17/review_router"
# Also configure the four source reconnect probe URLs, authenticated export
# witness, split Render keys, and ledger endpoint only in their exact protected
# workflow steps. Never place them in a shared Render environment group.

# Public URLs. GitHub App callback/setup/webhook URLs must match these hosts.
REVIEW_ROUTER_WEB_URL="https://reviewrouter.example.com"
REVIEW_ROUTER_API_URL="https://api.reviewrouter.example.com"
NEXTAUTH_URL="https://reviewrouter.example.com"
# URL embedded into generated GitHub Actions workflows. Must be public HTTPS in production.
REVIEW_ROUTER_PUBLIC_API_URL="https://api.reviewrouter.example.com"

# Auth.js / NextAuth. Use at least 32 random bytes for AUTH_SECRET.
AUTH_SECRET="replace-with-strong-random-secret"
AUTH_TRUST_HOST="true"

# GitHub OAuth / GitHub App.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
# Encrypts GitHub App user access tokens for maintainer repository discovery.
REVIEW_ROUTER_TOKEN_ENCRYPTION_KEY="replace-with-strong-random-secret-min-32"
# Preferred for hosted deploys. Paste the PEM as a secret value; escaped \n is supported.
GITHUB_APP_PRIVATE_KEY=""
# Alternative for file-mounted secrets.
# GITHUB_APP_PRIVATE_KEY_FILE="/run/secrets/reviewrouter-github-app.pem"
GITHUB_WEBHOOK_SECRET="replace-with-github-webhook-secret"
# Internal PG17 rollout ledger. API configuration stores only distinct SHA-256
# digests; plaintext bearer values stay in the protected callers.
REVIEW_ROUTER_RUNNER_LEDGER_TOKEN_SHA256=""
REVIEW_ROUTER_RELEASE_WITNESS_TOKEN_SHA256=""
# Separate Render credential restricted to read service, job, and log metadata.
REVIEW_ROUTER_RELEASE_WITNESS_RENDER_READ_TOKEN=""
# Exact identity of the immutable release running control and witness. The
# signed witness is rejected unless this tuple matches release provenance.
REVIEW_ROUTER_RELEASE_COMMIT_SHA="replace-with-40-character-release-commit-sha"
REVIEW_ROUTER_RELEASE_IMAGE_DIGEST="sha256:replace-with-64-character-image-digest"
# Independent release-control trust roots. Capture system identifiers in the
# signed rollout evidence and obtain routine hashes from the immutable release.
REVIEW_ROUTER_RELEASE_AUTHORITY_SYSTEM_IDENTIFIER="replace-with-authority-system-identifier"
REVIEW_ROUTER_ACTIVATION_TARGET_SYSTEM_IDENTIFIER="replace-with-target-system-identifier"
REVIEW_ROUTER_RELEASE_AUTHORITY_DATABASE_OID="replace-with-authority-database-oid"
REVIEW_ROUTER_RELEASE_AUTHORITY_DATABASE_NAME="replace-with-authority-database-name"
REVIEW_ROUTER_ACTIVATION_TARGET_DATABASE_OID="replace-with-target-database-oid"
REVIEW_ROUTER_ACTIVATION_TARGET_DATABASE_NAME="replace-with-target-database-name"
REVIEW_ROUTER_ACTIVATION_MIGRATION_MANIFEST_SHA256="sha256:replace-with-64-hex-digest"
REVIEW_ROUTER_ACTIVATION_NAMESPACE_FINGERPRINT="sha256:replace-with-64-hex-digest"
REVIEW_ROUTER_RELEASE_AUTHORITY_OWNER_ROLE="replace-with-canonical-authority-owner"
REVIEW_ROUTER_ACTIVATION_GUARD_ROLE="reviewrouter_activation_receipt_guard"
REVIEW_ROUTER_ACTIVATION_INSTALLER_BODY_SHA256="replace-with-64-character-body-sha256"
REVIEW_ROUTER_ACTIVATION_READER_BODY_SHA256="replace-with-64-character-body-sha256"

# Action control plane. Keep enabled for SaaS-managed setup PRs.
REVIEW_ROUTER_ENABLE_DASHBOARD_MUTATIONS="1"
REVIEW_ROUTER_ENABLE_WORKFLOW_PROVISIONING="1"
REVIEW_ROUTER_DISABLE_WORKFLOW_PROVISIONING="0"
REVIEW_ROUTER_DISABLE_ACTION_CONTROL_PLANE="0"
# Production workflows default to the live Action runtime for fastest review fixes.
# Use a full commit SHA only for deliberate rollback or smoke testing.
REVIEW_ROUTER_ACTION_REF="777genius/review-router@main"
# Required independently of the general channel above. Rotating namespace
# attestations use an exact release SHA for their full lifetime.
REVIEW_ROUTER_CODEX_ROTATING_ACTION_REF="777genius/review-router@replace-with-40-character-action-commit-sha"
REVIEW_ROUTER_CODEX_ROTATING_ALLOWED_ACTION_REFS=""
# Independently recorded public Action release used by hosted-pool workflows.
# The tag must resolve to this exact commit and dist/index.js digest; CI verifies
# the checked-in release pair before hosted-pool code can merge.
REVIEW_ROUTER_HOSTED_POOL_ACTION_TAG="replace-with-exact-v1.0.0-release"
REVIEW_ROUTER_HOSTED_POOL_ACTION_SHA="replace-with-40-character-action-commit-sha"
REVIEW_ROUTER_HOSTED_POOL_ACTION_DIST_SHA256="replace-with-64-character-dist-index-sha256"
# Deploy-helper trust root. Download the descriptor attached to the immutable
# release, verify its separately published SHA-256, and provide both here. The
# helper derives the installer URL/version/SHA-256 tuple from these exact bytes;
# direct tuple overrides are intentionally ignored.
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_DESCRIPTOR_FILE="/secure/path/reviewrouter-codex-rotating-installer-descriptor.json"
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_DESCRIPTOR_SHA256="replace-with-64-character-release-descriptor-sha256"
# Runtime/readiness projection of those verified descriptor bytes. Blueprint
# users copy these as one unit; the deploy helper overwrites them from the file.
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_URL="https://raw.githubusercontent.com/777genius/review-router/replace-with-40-character-action-commit-sha/scripts/seed-codex-rotating-auth.sh"
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_VERSION="replace-with-exact-v1.0.0-release"
REVIEW_ROUTER_CODEX_ROTATING_INSTALLER_SHA256="replace-with-64-character-seed-installer-sha256"
# One shared, secret-manager value for all web/API writers. Generate at least
# 32 random bytes and store the unpadded base64url encoding. Never log it.
REVIEW_ROUTER_DATABASE_RECOVERY_WITNESS="replace-with-base64url-database-recovery-witness"
REVIEW_ROUTER_ACTION_OIDC_AUDIENCE="reviewrouter"
REVIEW_ROUTER_ACTION_SESSION_SECRET="replace-with-strong-random-secret-min-32"
REVIEW_ROUTER_BLOCKED_ACTION_VERSIONS=""
# Authoritative server-side ceiling evaluated before OAuth or provider work.
REVIEW_ROUTER_HOSTED_MAX_CHANGED_LINES="250000"
REVIEW_ROUTER_ENABLE_CODEX_ROTATING_OAUTH="0"
REVIEW_ROUTER_CODEX_ROTATING_NEW_WORK_ADMISSION_ENABLED="0"
REVIEW_ROUTER_CODEX_ROTATING_SETUP_ISSUANCE_ENABLED="0"
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=""

# Hosted account pool stays closed until the canary and operator drain gates
# pass. The deploy helper projects only the least-privilege values needed by
# each runtime role; worker receives none of this custody configuration.
REVIEW_ROUTER_ENABLE_HOSTED_CODEX_POOL="0"
REVIEW_ROUTER_ENABLE_HOSTED_CODEX_CUSTODY="0"
REVIEW_ROUTER_ENABLE_HOSTED_CODEX_ADMISSION="0"
REVIEW_ROUTER_ENABLE_HOSTED_CODEX_RELAY="0"
REVIEW_ROUTER_ENABLE_HOSTED_CODEX_FAILOVER="0"
REVIEW_ROUTER_HOSTED_CODEX_KEYRING_MODE="external_kms"
REVIEW_ROUTER_HOSTED_CODEX_KMS_KEY_ARN="arn:aws:kms:REGION:ACCOUNT:key/replace-with-key-uuid"
AWS_REGION="replace-with-aws-region"
REVIEW_ROUTER_HOSTED_CODEX_RELAY_AWS_ROLE_ARN="arn:aws:iam::ACCOUNT:role/replace-with-relay-role"
REVIEW_ROUTER_HOSTED_CODEX_ENROLLMENT_AWS_ROLE_ARN="arn:aws:iam::ACCOUNT:role/replace-with-enrollment-role"
REVIEW_ROUTER_HOSTED_CODEX_RECOVERY_AWS_ROLE_ARN="arn:aws:iam::ACCOUNT:role/replace-with-recovery-role"
# Never set REVIEW_ROUTER_HOSTED_CODEX_AWS_ROLE_ARN in this source file. The
# deploy helper derives that runtime-only value from the role-specific ARNs.
REVIEW_ROUTER_HOSTED_CODEX_DATABASE_RESOURCE_IDENTITY="render:postgres:replace-with-dpg-resource-id"
REVIEW_ROUTER_HOSTED_CODEX_DATABASE_INCARNATION="replace-with-external-base64url-incarnation"
REVIEW_ROUTER_HOSTED_CODEX_FINGERPRINT_PEPPER="replace-with-canonical-base64-32-byte-secret"
REVIEW_ROUTER_HOSTED_CODEX_CAPABILITY_HMAC_KEY="replace-with-canonical-base64-32-byte-secret"
# Offline operator/canary inputs are not projected into runtime services. Keep
# their Render/GitHub tokens and operator DATABASE_URL out of this deploy file.
# Pin these non-secret identities separately before a dry-run preflight:
# REVIEW_ROUTER_HOSTED_POOL_RENDER_SERVICE_IDS=srv-api,srv-web
# REVIEW_ROUTER_HOSTED_POOL_CANARY_REPOSITORY_ID=replace-with-numeric-id
# REVIEW_ROUTER_HOSTED_POOL_CANARY_INSTALLATION_ID=replace-with-numeric-id
# REVIEW_ROUTER_HOSTED_POOL_CANARY_REPOSITORY_ALLOWLIST=replace-with-same-repository-id
# REVIEW_ROUTER_HOSTED_POOL_CANARY_ACTION_SHA=replace-with-same-action-commit-sha
# REVIEW_ROUTER_HOSTED_POOL_CANARY_APP_SLUG=replace-with-app-slug
# REVIEW_ROUTER_HOSTED_POOL_CANARY_RUN_IDS_JSON=replace-with-five-pinned-run-ids
# Empty means all repositories. Set to comma-separated owner/repo values only
# for a temporary production rollback/limited rollout.
REVIEW_ROUTER_CODEX_ROTATING_OAUTH_REPOSITORIES=""

# Review defaults for newly configured repositories.
REVIEW_ROUTER_DEFAULT_MODEL="gpt-5.6-sol"
REVIEW_ROUTER_DEFAULT_EFFORT="xhigh"
# SHA-256 only. Never store the plaintext operator credential on the server.
REVIEW_ROUTER_REVIEW_CONFIG_OPERATOR_CREDENTIAL_SHA256=""
# Public Ed25519 verification keys only. Never configure evaluator private keys here.
REVIEW_ROUTER_INVESTIGATION_EVALUATION_PUBLIC_KEYS_JSON=""
# Dedicated operation credentials must be distinct.
REVIEW_ROUTER_INVESTIGATION_PROMOTION_CREDENTIAL_SHA256=""
REVIEW_ROUTER_INVESTIGATION_EVALUATION_IMPORT_CREDENTIAL_SHA256=""
REVIEW_ROUTER_INVESTIGATION_PROMOTION_POLICY_PROFILES_JSON=""
# Dormant until an approved promotion report and explicit cohort exist.
REVIEW_ROUTER_REVIEW_INVESTIGATION_RECORDING_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_SHADOW_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_CONTEXT_CRITIC_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_VERIFIED_CLEAN_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_CROSS_REVISION_REPLAY_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRODUCTION_EFFECTS_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_EMERGENCY_DISABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_SELECTORS_JSON=""
REVIEW_ROUTER_ENABLE_CONFLICT_REVIEW_FALLBACK="1"
# Empty means all repositories. Set to comma-separated owner/repo values to
# temporarily restrict rollout.
REVIEW_ROUTER_CONFLICT_REVIEW_FALLBACK_REPOSITORIES=""

# Worker tuning.
REVIEW_ROUTER_OUTBOX_BATCH_SIZE="25"
REVIEW_ROUTER_OUTBOX_PROCESSING_STALE_MS="900000"
REVIEW_ROUTER_WORKER_IDLE_MS="5000"
REVIEW_ROUTER_WORKER_BUSY_MS="250"
REVIEW_ROUTER_WORKER_ERROR_MS="5000"
REVIEW_ROUTER_MAX_REPOSITORIES_PER_SYNC="250"
# Required before investigation recording can accept private search queries.
# Resolve both key settings from the secret manager, never from committed files.
REVIEW_ROUTER_REVIEW_INVESTIGATION_LEASE_CAPABILITY_ACTIVE_KEY_ID=""
REVIEW_ROUTER_REVIEW_INVESTIGATION_LEASE_CAPABILITY_KEYS_JSON=""
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_ACTIVE_KEY_ID=""
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_KEYS_JSON=""
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_TTL_MS="86400000"
# Required when investigation recording is enabled, after migrations deploy.
# Batch sizes are capped at 1000; live evidence prevents premature pruning.
REVIEW_ROUTER_REVIEW_INVESTIGATION_MAINTENANCE_ENABLED="0"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRIVATE_MATERIAL_PRUNE_BATCH_SIZE="100"
REVIEW_ROUTER_REVIEW_INVESTIGATION_DOSSIER_PRUNE_BATCH_SIZE="100"
REVIEW_ROUTER_REVIEW_INVESTIGATION_SHADOW_EVIDENCE_PRUNE_BATCH_SIZE="100"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRUNE_INTERVAL_MS="3600000"
REVIEW_ROUTER_REVIEW_INVESTIGATION_PRUNE_LOCK_TTL_MS="300000"
