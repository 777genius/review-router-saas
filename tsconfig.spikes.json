{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@reviewrouter/features-action-control-plane": [
        "./packages/features/action-control-plane/src/index.ts"
      ],
      "@reviewrouter/features-repositories": [
        "./packages/features/repositories/src/index.ts"
      ],
      "@reviewrouter/features-gitlab-integration": [
        "./packages/features/gitlab-integration/src/index.ts"
      ],
      "@reviewrouter/subscription-runtime-core": [
        "./packages/subscription-runtime/core/src/index.ts"
      ],
      "@reviewrouter/subscription-runtime-provider-codex": [
        "./packages/subscription-runtime/provider-codex/src/index.ts"
      ],
      "@reviewrouter/subscription-runtime-store-local-file": [
        "./packages/subscription-runtime/store-local-file/src/index.ts"
      ],
      "@reviewrouter/platform-db": ["./packages/platform/db/src/index.ts"],
      "@reviewrouter/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["spikes/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next"]
}
